{
  "name": "dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:client": "node ./client-gateway.mjs",
    "build:client": "vite build --config vite.client.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:client": "vite preview --config vite.client.config.ts",
    "test": "vitest run",
    "test:gateway": "node ./client-gateway.test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
