#!/usr/bin/env bash
# START_ADMIN — connect to VS SERVER and show REAL telemetry diagnostic.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

if [[ ! -d node_modules ]]; then
  echo "FAIL: run INSTALL_ADMIN first" >&2
  exit 1
fi

if [[ -z "${VS_SERVER_URL:-}" && ! -f config/admin.connection.json ]]; then
  echo "FAIL: configure VS_SERVER_URL or config/admin.connection.json" >&2
  exit 1
fi

echo "VS ADMIN START"
exec npx tsx app/startAdmin.ts "$@"
