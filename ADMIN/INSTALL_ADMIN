#!/usr/bin/env bash
# INSTALL_ADMIN — Linux/macOS path (Windows: INSTALL_ADMIN.bat).
# Product foundation: deps, device keys, LAN discovery, enrollment, verify snapshot.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$ROOT/.." && pwd)"
cd "$ROOT"

echo "VS ADMIN INSTALL (Unix)"
echo "Windows MSI users: run INSTALL_ADMIN.bat instead"

if ! command -v node >/dev/null; then
  echo "FAIL: Node.js 20+ required" >&2
  exit 1
fi

npm install

DASH_V2="$ROOT/apps/dashboard-v2"
DASH_LEGACY="$REPO/Old-system/apps/dashboard"
if [[ -d "$DASH_V2" ]]; then
  (cd "$DASH_V2" && npm install)
elif [[ -d "$DASH_LEGACY" ]]; then
  (cd "$DASH_LEGACY" && npm install)
fi

mkdir -p config "${VS_ADMIN_DATA:-$REPO/data/vs-admin}/keys"

# Shared installer (discover + enroll + ADMIN_SNAPSHOT verify)
npx tsx app/installAdmin.ts
exit $?
