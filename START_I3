#!/usr/bin/env bash
# =============================================================================
# START_I3 — canonical i3 operator entrypoint
#
#   cd ~/VS-new/VS
#   sudo bash START_I3
#
# Installs/updates VS CORE, Control API :3000 (LAN), Client Gateway :443,
# Postgres/Redis (internal), firewall, monitor.
# Does NOT recreate the database unless VS_NUCLEAR_DB=1.
# Does NOT change VS_PUBLIC_CLIENT_URL once set (/etc/vs/client-url).
# =============================================================================
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: run as:  sudo bash START_I3" >&2
  exit 1
fi

ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"

echo "########################################"
echo "#  VS — START_I3"
echo "########################################"

git pull origin main 2>/dev/null || true

if [[ ! -x "$ROOT/SERVER/MAKE_IT_WORK.sh" ]]; then
  echo "FAIL: missing SERVER/MAKE_IT_WORK.sh" >&2
  exit 1
fi

bash "$ROOT/SERVER/MAKE_IT_WORK.sh"
rc=$?
if [[ "$rc" -ne 0 ]]; then
  echo "FAIL: MAKE_IT_WORK exit $rc" >&2
  exit "$rc"
fi

LAN_IP="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' || true)"
STABLE=""
if [[ -f /etc/vs/client-url ]]; then
  STABLE="$(grep -v '^#' /etc/vs/client-url | head -1 | tr -d '[:space:]' || true)"
fi

echo
echo "########################################"
echo "#  VS CORE READY"
echo "#  SERVER ID     VS-CORE-01"
echo "#  ADMIN API     http://${LAN_IP}:3000/health   (LAN only)"
echo "#  CLIENT HTTPS  ${STABLE:-set /etc/vs/client-url}  (:443)"
echo "#  MONITOR       vs-monitor"
echo "#  MSI           START_MSI.bat  SERVER_IP=${LAN_IP}"
echo "########################################"

if [[ -n "$LAN_IP" ]] && ! curl -fsS --connect-timeout 3 "http://${LAN_IP}:3000/health" >/dev/null; then
  echo "WARN: LAN health failed — re-applying firewall" >&2
  bash "$ROOT/SERVER/network/APPLY_FIREWALL" || true
  bash "$ROOT/SERVER/OPEN_LAN_FOR_MSI.sh" || true
fi
exit 0
