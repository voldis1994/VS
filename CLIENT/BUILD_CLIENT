#!/usr/bin/env bash
# BUILD_CLIENT — build VS CLIENT desktop UI for device install.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
echo "VS CLIENT BUILD"

if [[ -f "$ROOT/desktop/package.json" ]]; then
  cd "$ROOT/desktop"
  if [[ ! -d node_modules ]]; then
    npm ci || npm install
  fi
  npm run build
  echo "SUCCESS: CLIENT/desktop built"
  exit 0
fi

echo "FAIL: CLIENT/desktop missing"
exit 1
