#!/usr/bin/env bash
# STOP_ADMIN — stop local diagnostic admin client process
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
PID_FILE="${VS_ADMIN_DATA:-$ROOT/data}/admin.pid"
echo "VS ADMIN STOP"
if [[ -f "$PID_FILE" ]] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
  kill "$(cat "$PID_FILE")" || true
  rm -f "$PID_FILE"
  echo "SUCCESS: stopped"
  exit 0
fi
echo "SUCCESS: not running"
exit 0
