#!/usr/bin/env bash
# START_ADMIN — prefer Control Panel against i3; CLI diagnostic with --cli
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$ROOT/.." && pwd)"
cd "$ROOT"

if [[ "${1:-}" == "--cli" ]]; then
  shift
  if [[ ! -d node_modules ]]; then
    echo "FAIL: run INSTALL_ADMIN first" >&2
    exit 1
  fi
  if [[ -f config/control-panel.env ]]; then
    set -a
    # shellcheck disable=SC1091
    source config/control-panel.env
    set +a
  fi
  echo "VS ADMIN START (CLI diagnostic)"
  exec npx tsx app/startAdmin.ts "$@"
fi

# Default: web Control Panel (same as START_CONTROL_PANEL)
exec bash "$ROOT/START_CONTROL_PANEL" "$@"
