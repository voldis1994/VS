#!/usr/bin/env bash
# START_CONTROL_PANEL — start Vite Control Panel against configured i3 SERVER URL.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
DASH="$ROOT/desktop"
CFG="$ROOT/config/control-panel.env"

if [[ ! -d "$DASH" ]]; then
  echo "FAIL: ADMIN/desktop missing" >&2
  exit 1
fi

if [[ -f "$CFG" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$CFG"
  set +a
fi

SERVER_URL="${VS_SERVER_URL:-${VITE_API_URL:-http://192.168.0.10:3000}}"
export VITE_API_URL="$SERVER_URL"
export VITE_WS_URL="${VITE_WS_URL:-${SERVER_URL/http/ws}/ws}"
export VITE_API_ADMIN_TOKEN="${API_ADMIN_TOKEN:-${VITE_API_ADMIN_TOKEN:-}}"
export API_ADMIN_TOKEN="${API_ADMIN_TOKEN:-}"

echo "VS CONTROL PANEL"
echo "  API = $VITE_API_URL"
echo "  WS  = $VITE_WS_URL"

if ! curl -fsS --max-time 5 "$SERVER_URL/health" >/dev/null 2>&1; then
  echo "FAIL: cannot reach $SERVER_URL/health" >&2
  echo "  - Is i3 SERVER running?  (STATUS_SERVER on i3)" >&2
  echo "  - Same Wi-Fi? Update VS_SERVER_URL in $CFG" >&2
  exit 1
fi
echo "  health OK"

if [[ ! -d "$DASH/node_modules" ]]; then
  echo "FAIL: run INSTALL_ADMIN / INSTALL_CONTROL_PANEL first" >&2
  exit 1
fi

cd "$DASH"
exec npx vite --host 127.0.0.1 --port 5173
