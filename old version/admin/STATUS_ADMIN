#!/usr/bin/env bash
# STATUS_ADMIN — local connection status (never invent SERVER LIVE)
set -euo pipefail
ROOT="$(cd "$(dirname "$0")" && pwd)"
cd "$ROOT"
export VS_SERVER_URL="${VS_SERVER_URL:-}"
if [[ -z "$VS_SERVER_URL" && -f config/admin.connection.json ]]; then
  VS_SERVER_URL="$(node -e "console.log(JSON.parse(require('fs').readFileSync('config/admin.connection.json','utf8')).baseUrl||'')")"
fi
if [[ -z "$VS_SERVER_URL" ]]; then
  echo "CONNECTION DISCONNECTED"
  echo "FAIL: no VS_SERVER_URL configured"
  exit 1
fi
echo "VS ADMIN STATUS"
echo "TARGET $VS_SERVER_URL"
if curl -fsS --max-time 3 "$VS_SERVER_URL/health" >/dev/null 2>&1; then
  echo "CONNECTION REACHABLE"
  echo "RESULT=SUCCESS"
  exit 0
fi
echo "CONNECTION DISCONNECTED"
echo "RESULT=FAIL"
exit 1
