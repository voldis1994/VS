[Unit]
Description=VS Client API (WireGuard clients)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vs/SERVER/client-api
EnvironmentFile=-/var/lib/vs-server/server.env
ExecStart=/usr/bin/env npx tsx src/index.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
