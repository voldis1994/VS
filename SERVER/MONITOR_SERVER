#!/usr/bin/env bash
# MONITOR_SERVER — local read-only physical status display for i3 console.
# Closing this does NOT stop vs-server, Postgres, Redis, or WireGuard.
#
# Prefer:  vs-monitor
# Or:      sudo bash SERVER/SHOW_LIVE_MONITOR.sh
#
# Does NOT source /var/lib/vs-server/server.env secrets.
# Uses localhost Control API console endpoint instead.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
PREFIX="${VS_SERVER_PREFIX:-${VS_SERVER_ROOT:-/opt/vs-server}}"
DATA="${VS_SERVER_DATA:-${VS_CORE_DATA:-/var/lib/vs-server}}"
PORT="${CONTROL_API_PORT:-3000}"
BASE="${VS_MONITOR_API_URL:-http://127.0.0.1:${PORT}}"
BASE="${BASE%/}"
REFRESH_MS="${VS_MONITOR_REFRESH_MS:-800}"
REFRESH_SEC="$(awk -v ms="$REFRESH_MS" 'BEGIN { printf "%.3f", (ms < 250 ? 250 : ms) / 1000 }')"

export VS_SERVER_DATA="$DATA"
export VS_CORE_DATA="$DATA"
export VS_SERVER_ROOT="$PREFIX"
export VS_CORE_ROOT="$PREFIX"
export CONTROL_API_PORT="$PORT"
export VS_MONITOR_API_URL="$BASE"
export VS_MONITOR_REFRESH_MS="$REFRESH_MS"
export LIVE_TRADING_ENABLED="${LIVE_TRADING_ENABLED:-false}"

resolve_api_dir() {
  local candidates=(
    "$PREFIX/control-api"
    "/opt/vs-server/control-api"
    "$ROOT/control-api"
  )
  local d
  for d in "${candidates[@]}"; do
    if [[ -f "$d/package.json" && -x "$d/node_modules/.bin/tsx" ]]; then
      echo "$d"
      return 0
    fi
  done
  for d in "${candidates[@]}"; do
    if [[ -f "$d/package.json" && -d "$d/node_modules/tsx" ]]; then
      echo "$d"
      return 0
    fi
  done
  for d in "${candidates[@]}"; do
    if [[ -f "$d/package.json" ]]; then
      echo "$d"
      return 0
    fi
  done
  return 1
}

run_tsx_monitor() {
  local api="$1"
  cd "$api"
  if [[ -x ./node_modules/.bin/tsx ]]; then
    exec ./node_modules/.bin/tsx src/vs-core/runServerMonitor.ts
  fi
  if [[ -d ./node_modules/tsx ]]; then
    exec node --import tsx src/vs-core/runServerMonitor.ts
  fi
  return 1
}

# Bash/curl fallback — works without tsx once Control API is up.
# Never reads server.env. Never invents LIVE.
run_curl_monitor() {
  echo "VS SERVER MONITOR (curl console) — read-only; Ctrl+C stops monitor only" >&2
  echo "API $BASE  refresh ${REFRESH_MS}ms" >&2
  local frame
  while true; do
    if frame="$(curl -fsS --max-time 8 "$BASE/api/v1/server/monitor/console/text" 2>/dev/null)"; then
      if [[ -t 1 ]]; then printf '\033c'; fi
      printf '%s\n' "$frame"
    elif curl -fsS --max-time 3 "$BASE/health" >/dev/null 2>&1; then
      if [[ -t 1 ]]; then printf '\033c'; fi
      cat <<EOF
╔════════════════════════════════════════════════════════════╗
║                    VS CORE SERVER                          ║
║                      VS-CORE-01                            ║
╠════════════════════════════════════════════════════════════╣
║  STATUS: API UP — monitor console route not loaded yet     ║
║  ACTION: sudo systemctl restart vs-server                  ║
║  DETAIL: /api/v1/server/monitor/console/text missing       ║
║  $(date -u '+%Y-%m-%d %H:%M:%S UTC')                                         ║
╚════════════════════════════════════════════════════════════╝
EOF
    else
      if [[ -t 1 ]]; then printf '\033c'; fi
      cat <<EOF
╔════════════════════════════════════════════════════════════╗
║                    VS CORE SERVER                          ║
║                      VS-CORE-01                            ║
╠════════════════════════════════════════════════════════════╣
║  CONTROL API          ● OFFLINE                            ║
║  DATABASE             ○ UNKNOWN                            ║
║  REDIS                ○ UNKNOWN                            ║
║  ADMIN                ○ UNKNOWN                            ║
║  CLIENTS              ○ UNKNOWN                            ║
║  LAST ERROR: cannot reach $BASE/health
║  FIX: sudo bash SERVER/FIX_CONTROL_API.sh
║  $(date -u '+%Y-%m-%d %H:%M:%S UTC')
║  READ-ONLY — closing this does not stop the server         ║
╚════════════════════════════════════════════════════════════╝
EOF
    fi
    sleep "$REFRESH_SEC"
  done
}

API_DIR=""
if API_DIR="$(resolve_api_dir)"; then
  if [[ -x "$API_DIR/node_modules/.bin/tsx" || -d "$API_DIR/node_modules/tsx" ]]; then
    run_tsx_monitor "$API_DIR" || true
  fi
fi

# If tsx path failed or missing — still show a live dashboard via curl.
echo "WARN: local tsx runtime missing under installed control-api — using console API fallback" >&2
echo "      Fix permanently: sudo bash SERVER/install/INSTALL_I3_SERVER.sh" >&2
run_curl_monitor
