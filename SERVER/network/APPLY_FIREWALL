#!/usr/bin/env bash
# APPLY_FIREWALL — SERVER host firewall for VS (product).
# DEFAULT INBOUND DENY.
# - WireGuard UDP publicly reachable (remote clients)
# - Control API TCP only from: localhost + LAN CIDR + VS WireGuard supernet
# - PostgreSQL/Redis NOT exposed (compose binds 127.0.0.1)
# CLIENT↛ADMIN / CLIENT↛CLIENT on forward chain
set -euo pipefail

WG_IFACE="${VS_WG_INTERFACE:-vs0}"
WG_PORT="${VS_WG_LISTEN_PORT:-51820}"
API_PORT="${CONTROL_API_PORT:-3000}"
SUPERNET="${VS_WG_SUBNET:-10.77.0.0/16}"
ADMIN_NET="${VS_WG_ADMIN_NET:-10.77.1.0/24}"
CLIENT_NET="${VS_WG_CLIENT_NET:-10.77.10.0/20}"
SERVER_IP="${VS_WG_SERVER_IP:-10.77.0.1}"

# LAN for MSI Control Panel (same Wi-Fi). Override with VS_LAN_CIDR=192.168.0.0/24
detect_lan_cidr() {
  if [[ -n "${VS_LAN_CIDR:-}" ]]; then
    echo "$VS_LAN_CIDR"
    return
  fi
  local src
  src="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' || true)"
  if [[ "$src" =~ ^([0-9]+\.[0-9]+\.[0-9]+)\.[0-9]+$ ]]; then
    echo "${BASH_REMATCH[1]}.0/24"
    return
  fi
  echo "192.168.0.0/16"
}
LAN_CIDR="$(detect_lan_cidr)"

echo "VS SERVER FIREWALL (product)"
echo "IFACE=$WG_IFACE WG_UDP=$WG_PORT API_TCP=$API_PORT"
echo "LAN_CIDR=$LAN_CIDR WG_SUPERNET=$SUPERNET"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: APPLY_FIREWALL requires root" >&2
  exit 1
fi

if command -v ufw >/dev/null 2>&1; then
  ufw --force reset || true
  ufw default deny incoming
  ufw default allow outgoing
  ufw allow OpenSSH || ufw allow 22/tcp || true
  ufw allow "${WG_PORT}/udp" comment 'VS WireGuard'
  ufw allow from "$LAN_CIDR" to any port "$API_PORT" proto tcp comment 'VS Control API LAN (MSI)'
  ufw allow from "$SUPERNET" to any port "$API_PORT" proto tcp comment 'VS Control API WireGuard'
  ufw allow from 127.0.0.1 to any port "$API_PORT" proto tcp comment 'VS Control API localhost'
  ufw --force enable
  echo "SUCCESS: ufw deny-in + WG UDP + API from LAN/WG/lo only"
fi

if command -v nft >/dev/null 2>&1; then
  nft delete table inet vs_private 2>/dev/null || true
  nft -f - <<EOF
table inet vs_private {
  chain input {
    type filter hook input priority 0; policy drop;
    ct state established,related accept
    iif lo accept
    udp dport ${WG_PORT} accept
    tcp dport 22 accept
    ip saddr ${LAN_CIDR} tcp dport ${API_PORT} accept
    ip saddr ${SUPERNET} tcp dport ${API_PORT} accept
  }
  chain forward {
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    ip saddr ${ADMIN_NET} ip daddr ${SERVER_IP} accept
    ip saddr ${CLIENT_NET} ip daddr ${SERVER_IP} accept
    ip saddr ${CLIENT_NET} ip daddr ${ADMIN_NET} drop
    ip saddr ${CLIENT_NET} ip daddr ${CLIENT_NET} drop
  }
}
EOF
  echo "SUCCESS: nftables vs_private (API LAN+WG only; CLIENT↛ADMIN)"
  exit 0
fi

if command -v ufw >/dev/null 2>&1; then
  exit 0
fi

echo "FAIL: neither ufw nor nft available" >&2
exit 1
