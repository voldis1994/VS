#!/usr/bin/env bash
# APPLY_FIREWALL — home appliance: MSI on Wi‑Fi must reach Control API :3000.
# Prefer reachability over narrow CIDR guessing. WireGuard UDP still opened.
set -euo pipefail

WG_PORT="${VS_WG_LISTEN_PORT:-51820}"
API_PORT="${CONTROL_API_PORT:-3000}"
SUPERNET="${VS_WG_SUBNET:-10.77.0.0/16}"

echo "VS SERVER FIREWALL (home appliance)"
echo "WG_UDP=$WG_PORT API_TCP=$API_PORT"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: APPLY_FIREWALL requires root" >&2
  exit 1
fi

# Remove prior fail-closed nft table (locked MSI out)
if command -v nft >/dev/null 2>&1; then
  nft delete table inet vs_private 2>/dev/null || true
  echo "OK: removed nft inet vs_private (if present)"
fi

# NUCLEAR home allow: any source → :3000 (bind is still local LAN interfaces)
# Required because Wi‑Fi AP isolation / wrong CIDR / Tailscale source IPs broke MSI.
if command -v iptables >/dev/null 2>&1; then
  iptables -D INPUT -p tcp --dport "$API_PORT" -j ACCEPT 2>/dev/null || true
  iptables -I INPUT 1 -p tcp --dport "$API_PORT" -j ACCEPT || true
  iptables -D INPUT -p udp --dport "$WG_PORT" -j ACCEPT 2>/dev/null || true
  iptables -I INPUT 1 -p udp --dport "$WG_PORT" -j ACCEPT || true
  echo "OK: iptables ACCEPT tcp/$API_PORT + udp/$WG_PORT (any)"
fi

if command -v ufw >/dev/null 2>&1; then
  ufw allow OpenSSH 2>/dev/null || ufw allow 22/tcp 2>/dev/null || true
  ufw allow "${WG_PORT}/udp" comment 'VS WireGuard' 2>/dev/null || true
  ufw allow "${API_PORT}/tcp" comment 'VS Control API home (MSI LAN)' 2>/dev/null || true
  ufw allow from "$SUPERNET" to any port "$API_PORT" proto tcp comment 'VS Control API WG' 2>/dev/null || true
  ufw --force enable 2>/dev/null || true
  ufw status numbered 2>/dev/null | head -40 || true
  echo "SUCCESS: ufw allow ${API_PORT}/tcp (any) + WG"
  exit 0
fi

echo "SUCCESS: iptables open (ufw not installed)"
exit 0
