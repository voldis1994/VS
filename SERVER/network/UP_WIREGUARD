#!/usr/bin/env bash
# Bring up WireGuard interface from data-dir keys (physical SERVER).
# Uses `wg setconf` (NOT wg-quick) — so Address/DNS/MTU/SaveConfig must be stripped;
# IP is applied with `ip address` below.
set -euo pipefail

DATA="${VS_SERVER_DATA:-${VS_CORE_DATA:-/var/lib/vs-server}}"
IFACE="${VS_WG_INTERFACE:-vs0}"
PORT="${VS_WG_LISTEN_PORT:-51820}"
SERVER_ID="${VS_SERVER_ID:-VS-CORE-01}"
SERVER_CIDR="${VS_WG_SERVER_CIDR:-10.77.0.1/24}"

PRIV="$DATA/network/keys/${SERVER_ID}.private"
if [[ ! -f "$PRIV" ]]; then
  echo "FAIL: missing $PRIV — run SETUP_PRIVATE_NETWORK / ensureServerIdentity first" >&2
  exit 1
fi

if ! command -v wg >/dev/null; then
  echo "FAIL: wireguard-tools (wg) not installed" >&2
  exit 1
fi

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: root required to configure ${IFACE}" >&2
  exit 1
fi

# Generate live conf with real private key (never committed).
# Trap ensures the temp file is removed even if the script exits mid-flight,
# so the private key never lingers on disk.
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT INT TERM
chmod 600 "$TMP"
PRIV_KEY="$(tr -d '\n' < "$PRIV")"
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT/control-api"
if [[ ! -x node_modules/.bin/tsx ]]; then
  echo "FAIL: control-api node_modules missing — run INSTALL_SERVER" >&2
  exit 1
fi
CONF="$(VS_SERVER_DATA="$DATA" ./node_modules/.bin/tsx -e "
import { getDeviceRegistry } from './src/vs-core/network/deviceRegistry.ts';
import { buildServerConfFromRegistry } from './src/vs-core/network/wireguardConfig.ts';
const root = process.env.VS_SERVER_DATA || '';
if (!root) throw new Error('VS_SERVER_DATA required');
const reg = getDeviceRegistry(root);
process.stdout.write(buildServerConfFromRegistry(reg, '___PRIV___'));
")"
# wg setconf rejects wg-quick-only keys (Address, DNS, MTU, SaveConfig, Pre*/Post*)
echo "$CONF" | sed "s|___PRIV___|${PRIV_KEY}|" \
  | grep -v -E '^[[:space:]]*(Address|DNS|MTU|SaveConfig|PreUp|PostUp|PreDown|PostDown)[[:space:]]*=' \
  >"$TMP"
ip link add dev "$IFACE" type wireguard 2>/dev/null || true
wg setconf "$IFACE" "$TMP"
# $TMP is removed by the EXIT trap above — no explicit rm needed.
ip address replace "$SERVER_CIDR" dev "$IFACE" 2>/dev/null || ip addr add "$SERVER_CIDR" dev "$IFACE"
ip link set "$IFACE" up
echo "SUCCESS: ${IFACE} up on ${SERVER_CIDR}"
wg show "$IFACE"
