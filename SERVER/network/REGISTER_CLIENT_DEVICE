#!/usr/bin/env bash
# REGISTER_CLIENT_DEVICE — foundation for CLIENT peer issuance.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
DATA="${VS_SERVER_DATA:-${VS_CORE_DATA:-/var/lib/vs-server}}"
export VS_SERVER_DATA="$DATA"
export VS_CORE_DATA="$DATA"
CLIENT_ID="${1:?client_id required}"
NAME="${2:-}"

cd "$ROOT/control-api"
exec npx tsx -e "
import { getDeviceRegistry } from './src/vs-core/network/deviceRegistry.ts';
import { ensureServerIdentity, registerClientDevice } from './src/vs-core/network/deviceLifecycle.ts';
const root = process.env.VS_SERVER_DATA!;
const reg = getDeviceRegistry(root);
ensureServerIdentity(reg, root);
const issued = registerClientDevice(reg, root, {
  client_id: Number('${CLIENT_ID}'),
  device_name: '${NAME}' || undefined,
});
console.log(JSON.stringify({
  ok: true,
  device_id: issued.device_id,
  private_ip: issued.private_ip,
  client_id: issued.client_id,
  peer_config_path: issued.peer_config_path,
  device_token: issued.device_token,
}, null, 2));
"
