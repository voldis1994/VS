#!/usr/bin/env bash
# FIX_WIFI — repair WiFi on Debian VS SERVER appliance (i3).
# Safe to re-run. Does not enable LIVE trading.
#
# Optional env:
#   WIFI_SSID=...
#   WIFI_PASSWORD=...
#   WIFI_IFACE=wlan0          # auto-detect if unset
#   WIFI_COUNTRY=LV           # regulatory domain
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: FIX_WIFI requires root (sudo)" >&2
  exit 1
fi

echo "========================================"
echo " VS SERVER — FIX WIFI"
echo "========================================"

export DEBIAN_FRONTEND=noninteractive
WIFI_COUNTRY="${WIFI_COUNTRY:-LV}"

# Debian 12+ : enable non-free-firmware for WiFi chip blobs (idempotent)
enable_nonfree_firmware() {
  local changed=0
  if [[ -d /etc/apt/sources.list.d ]]; then
    local f
    for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.sources /etc/apt/sources.list.d/*.list; do
      [[ -f "$f" ]] || continue
      if grep -q 'Components:.*main' "$f" 2>/dev/null && ! grep -q 'non-free-firmware' "$f" 2>/dev/null; then
        sed -i 's/Components: \(.*\)/Components: \1 non-free-firmware contrib non-free/' "$f" 2>/dev/null || true
        # avoid duplicate words
        sed -i -E 's/(non-free-firmware)( non-free-firmware)+/\1/g; s/(contrib)( contrib)+/\1/g; s/(non-free)( non-free)+/\1/g' "$f" 2>/dev/null || true
        changed=1
      fi
      if grep -qE '^deb .* main' "$f" 2>/dev/null && ! grep -q 'non-free-firmware' "$f" 2>/dev/null; then
        sed -i -E 's/^(deb[^\n]* main)(.*)$/\1 contrib non-free non-free-firmware\2/' "$f" 2>/dev/null || true
        changed=1
      fi
    done
  fi
  if [[ "$changed" -eq 1 ]]; then
    echo "INFO: enabled contrib/non-free/non-free-firmware in apt sources"
  fi
}
enable_nonfree_firmware

# --- packages needed for WiFi + firmware ---
apt-get update -y
apt-get install -y --no-install-recommends \
  network-manager \
  wireless-tools \
  iw \
  rfkill \
  wpasupplicant \
  modemmanager \
  dnsutils \
  iproute2 \
  isc-dhcp-client \
  firmware-linux \
  firmware-linux-nonfree \
  firmware-iwlwifi \
  firmware-realtek \
  firmware-atheros \
  firmware-misc-nonfree \
  2>/dev/null || {
  # Some firmware metapackages differ by Debian edition — install what exists
  apt-get install -y --no-install-recommends \
    network-manager wireless-tools iw rfkill wpasupplicant \
    iproute2 dnsutils isc-dhcp-client || true
  apt-get install -y firmware-linux firmware-linux-nonfree 2>/dev/null || true
  apt-get install -y firmware-iwlwifi 2>/dev/null || true
  apt-get install -y firmware-realtek 2>/dev/null || true
  apt-get install -y firmware-atheros 2>/dev/null || true
  apt-get install -y firmware-misc-nonfree 2>/dev/null || true
}

# Non-free firmware often needs contrib/non-free enabled once
if ! grep -Rqs 'non-free-firmware\|non-free' /etc/apt/sources.list /etc/apt/sources.list.d 2>/dev/null; then
  echo "WARN: apt sources may lack non-free-firmware — WiFi chip firmware might be missing"
  echo "      On Debian 13 add non-free-firmware, then: apt update && apt install firmware-iwlwifi"
fi

# Prefer NetworkManager over conflicting legacy networking for WiFi
systemctl enable NetworkManager 2>/dev/null || true
systemctl start NetworkManager 2>/dev/null || true
systemctl disable --now wpa_supplicant@* 2>/dev/null || true
# Avoid networking.service fighting NM on managed ifaces
if systemctl is-enabled networking >/dev/null 2>&1; then
  echo "INFO: ifupdown networking enabled — NetworkManager will manage WiFi interfaces"
fi

# Unblock soft/hard rfkill
rfkill unblock wifi 2>/dev/null || true
rfkill unblock all 2>/dev/null || true
rfkill list || true

# Regulatory domain (helps 5 GHz / country channels)
if command -v iw >/dev/null 2>&1; then
  iw reg set "$WIFI_COUNTRY" 2>/dev/null || true
fi
if [[ -f /etc/default/crda ]]; then
  sed -i "s/^REGDOMAIN=.*/REGDOMAIN=${WIFI_COUNTRY}/" /etc/default/crda 2>/dev/null || true
fi

# Detect WiFi interface
detect_wifi_iface() {
  if [[ -n "${WIFI_IFACE:-}" ]]; then
    echo "$WIFI_IFACE"
    return
  fi
  local iface
  iface="$(iw dev 2>/dev/null | awk '/Interface/ {print $2; exit}')"
  if [[ -n "$iface" ]]; then
    echo "$iface"
    return
  fi
  iface="$(ls /sys/class/net 2>/dev/null | grep -E '^wl|^wlan' | head -1 || true)"
  echo "${iface:-}"
}

IFACE="$(detect_wifi_iface)"
if [[ -z "$IFACE" ]]; then
  echo "WARN: no WiFi interface found yet (driver/firmware may need reboot)"
  echo "      After reboot re-run: sudo $0"
  ip -br link || true
  ls /sys/class/net || true
  dmesg 2>/dev/null | grep -iE 'wifi|wlan|iwlwifi|ath|rtl|firmware' | tail -20 || true
  exit 0
fi

echo "WIFI_IFACE=$IFACE"
ip link set "$IFACE" up 2>/dev/null || true

# Let NetworkManager own the interface
if command -v nmcli >/dev/null 2>&1; then
  nmcli device set "$IFACE" managed yes 2>/dev/null || true
  nmcli radio wifi on 2>/dev/null || true
  # Clear stale DHCP / DNS
  nmcli networking on 2>/dev/null || true

  if [[ -n "${WIFI_SSID:-}" ]]; then
    echo "Connecting to SSID=${WIFI_SSID}"
    # Delete old profile with same name to avoid duplicate mess
    nmcli connection delete "$WIFI_SSID" 2>/dev/null || true
    if [[ -n "${WIFI_PASSWORD:-}" ]]; then
      nmcli device wifi connect "$WIFI_SSID" password "$WIFI_PASSWORD" ifname "$IFACE" || \
        nmcli connection add type wifi ifname "$IFACE" con-name "$WIFI_SSID" ssid "$WIFI_SSID" \
          wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$WIFI_PASSWORD" && \
        nmcli connection up "$WIFI_SSID"
    else
      nmcli device wifi connect "$WIFI_SSID" ifname "$IFACE" || true
    fi
  else
    echo "INFO: WIFI_SSID not set — bringing interface up; use existing NM profiles if any"
    # Try to activate any existing wifi connection
    EXISTING="$(nmcli -t -f NAME,TYPE connection show | awk -F: '$2=="802-11-wireless"{print $1; exit}')"
    if [[ -n "$EXISTING" ]]; then
      nmcli connection up "$EXISTING" ifname "$IFACE" || true
    fi
  fi
fi

# Wait for IPv4 + internet
ok=0
for i in $(seq 1 30); do
  if ip -4 addr show dev "$IFACE" 2>/dev/null | grep -q 'inet '; then
    if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 || ping -c1 -W2 8.8.8.8 >/dev/null 2>&1; then
      ok=1
      break
    fi
    # IP present but ping fails — try DNS fix
    if command -v resolvectl >/dev/null 2>&1; then
      resolvectl dns "$IFACE" 1.1.1.1 8.8.8.8 2>/dev/null || true
    elif [[ -f /etc/resolv.conf ]]; then
      if ! grep -q 'nameserver' /etc/resolv.conf; then
        printf 'nameserver 1.1.1.1\nnameserver 8.8.8.8\n' >/etc/resolv.conf
      fi
    fi
  fi
  sleep 1
done

echo "--- link ---"
ip -br link show "$IFACE" || true
echo "--- addr ---"
ip -4 addr show "$IFACE" || true
echo "--- route ---"
ip route | head -10 || true
echo "--- nmcli ---"
nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null || true

if [[ "$ok" -eq 1 ]]; then
  echo "SUCCESS: WiFi has IPv4 and internet reachability"
  exit 0
fi

if ip -4 addr show dev "$IFACE" 2>/dev/null | grep -q 'inet '; then
  echo "WARN: WiFi has IP but no internet ping — check gateway/DNS/captive portal"
  exit 0
fi

echo "FAIL: WiFi not associated / no IPv4 on $IFACE" >&2
echo "      Set WIFI_SSID + WIFI_PASSWORD and re-run, or configure via:" >&2
echo "      nmcli device wifi list" >&2
echo "      nmcli device wifi connect 'SSID' password 'PASS'" >&2
exit 1
