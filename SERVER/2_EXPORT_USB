#!/usr/bin/env bash
# =============================================================================
# 2_EXPORT_USB — VIENS fails: komunikācija (WireGuard + token) uz USB / Desktop
# =============================================================================
# Lietošana (root, USB iesprausts):
#   sudo bash /root/VS/SERVER/2_EXPORT_USB
# Vai bez USB (kopē uz /home/vs/VS-USB/):
#   sudo bash /root/VS/SERVER/2_EXPORT_USB
# =============================================================================
set -euo pipefail
if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: palaid kā root:  sudo bash $0" >&2
  exit 1
fi

DATA="${VS_SERVER_DATA:-/var/lib/vs-server}"
PREFIX="${VS_SERVER_PREFIX:-/opt/vs-server}"
HERE="$(cd "$(dirname "$0")" && pwd)"
PORT="${VS_WG_LISTEN_PORT:-51820}"

LAN_IP="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' || true)"
if [[ -z "$LAN_IP" ]]; then
  LAN_IP="$(ip -4 -br a | awk '/UP/ && $1!~/lo|vs0|docker|br-|veth/ {split($3,a,"/"); print a[1]; exit}')"
fi
if [[ -z "$LAN_IP" ]]; then
  echo "FAIL: nevar noteikt LAN IP — pieslēdz WiFi/ethernet" >&2
  exit 1
fi
export VS_SERVER_ENDPOINT_IP="$LAN_IP"
export VS_SERVER_LAN_IP="$LAN_IP"
export VS_SERVER_DATA="$DATA"

echo "========================================"
echo " EXPORT ADMIN USB PACK"
echo " LAN Endpoint = ${LAN_IP}:${PORT}"
echo "========================================"

# Ensure SERVER identity + ADMIN peer with correct Endpoint
if [[ -x "$PREFIX/network/REGISTER_ADMIN" ]]; then
  VS_SERVER_DATA="$DATA" VS_SERVER_ENDPOINT_IP="$LAN_IP" \
    "$PREFIX/network/REGISTER_ADMIN" VS-ADMIN-01 || true
elif [[ -x "$HERE/network/REGISTER_ADMIN" ]]; then
  VS_SERVER_DATA="$DATA" VS_SERVER_ENDPOINT_IP="$LAN_IP" \
    "$HERE/network/REGISTER_ADMIN" VS-ADMIN-01 || true
fi

CONF="$DATA/network/issued/VS-ADMIN-01.conf"
if [[ ! -f "$CONF" ]]; then
  echo "FAIL: missing $CONF — run 1_START_I3 first" >&2
  exit 1
fi

# Force numeric Endpoint (fixes Windows "No such host is known")
sed -i "s|^Endpoint = .*|Endpoint = ${LAN_IP}:${PORT}|" "$CONF"
grep -E '^Endpoint' "$CONF"

# Refresh WG peers on SERVER
if [[ -x "$PREFIX/network/UP_WIREGUARD" ]]; then
  VS_SERVER_DATA="$DATA" "$PREFIX/network/UP_WIREGUARD" || true
elif [[ -x "$HERE/network/UP_WIREGUARD" ]]; then
  VS_SERVER_DATA="$DATA" "$HERE/network/UP_WIREGUARD" || true
fi

TOKEN="$(grep -E '^API_ADMIN_TOKEN=' "$DATA/server.env" 2>/dev/null | cut -d= -f2- || true)"
ENROLL=""
if [[ -f "$DATA/network/issued/ADMIN_ENROLLMENT.json" ]]; then
  ENROLL="$(jq -r '.enrollment_code // empty' "$DATA/network/issued/ADMIN_ENROLLMENT.json" 2>/dev/null || true)"
fi

OUT_HOME="/home/vs/VS-USB"
mkdir -p "$OUT_HOME"
cp -a "$CONF" "$OUT_HOME/VS-ADMIN-01.conf"
cat >"$OUT_HOME/ADMIN_TOKEN.txt" <<EOF
API_ADMIN_TOKEN=${TOKEN}
VS_SERVER_URL=http://10.77.0.1:3000
VS_ENROLLMENT_CODE=${ENROLL}
ENDPOINT=${LAN_IP}:${PORT}
EOF
cat >"$OUT_HOME/README_WINDOWS.txt" <<EOF
VS ADMIN — Windows (otrais dators)
==================================
1) Uzliec WireGuard: https://www.wireguard.com/install/
2) Import tunnel: VS-ADMIN-01.conf  (Endpoint jau ir ${LAN_IP}:${PORT})
3) Spied Activate
4) PowerShell:  ping 10.77.0.1
5) PowerShell:  curl.exe http://10.77.0.1:3000/health
6) Dubultklikšķis: 1_START_WINDOWS.bat  (no VS\\ADMIN mapes)
   vai ielasi ADMIN_TOKEN.txt vērtības.

Abi datori jābūt vienā WiFi/LAN.
EOF
chown -R vs:vs "$OUT_HOME" 2>/dev/null || true
chmod 644 "$OUT_HOME"/* 2>/dev/null || true

# Copy to USB if mounted
USB_COPIED=0
for m in /mnt/usb /media/vs/* /media/*/*; do
  [[ -d "$m" ]] || continue
  if mountpoint -q "$m" 2>/dev/null || [[ -w "$m" ]]; then
    cp -a "$OUT_HOME"/. "$m"/ 2>/dev/null || continue
    sync
    echo "SUCCESS: nokopēts uz USB: $m"
    USB_COPIED=1
    break
  fi
done

# Auto-mount first removable partition if nothing mounted
if [[ "$USB_COPIED" -eq 0 ]]; then
  for dev in /dev/sd[b-z]1 /dev/sd[b-z]; do
    [[ -b "$dev" ]] || continue
    mkdir -p /mnt/usb
    if mount "$dev" /mnt/usb 2>/dev/null; then
      cp -a "$OUT_HOME"/. /mnt/usb/
      sync
      echo "SUCCESS: nokopēts uz $dev → /mnt/usb"
      echo "Izņem:  sync && umount /mnt/usb"
      USB_COPIED=1
      break
    fi
  done
fi

echo
echo "FAILI (arī bez USB): $OUT_HOME"
ls -la "$OUT_HOME"
echo
echo "Windows: ņem VS-ADMIN-01.conf + ADMIN_TOKEN.txt"
[[ "$USB_COPIED" -eq 1 ]] || echo "USB nav atrasts — nokopē mapi $OUT_HOME manuāli uz flašu"
exit 0
