#!/usr/bin/env bash
# LAUNCH_ALL — ONE script: install deps + local Postgres + VS SERVER + WireGuard + start.
# No Docker. No WiFi. DEMO only (LIVE=false).
#
# Usage (as root on Debian i3):
#   curl -fsSL … | bash
#   OR:  bash LAUNCH_ALL
#   OR:  cd /root/VS && sudo bash SERVER/LAUNCH_ALL
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: run as root:  sudo -i   then  bash SERVER/LAUNCH_ALL" >&2
  exit 1
fi

export DEBIAN_FRONTEND=noninteractive
export LIVE_TRADING_ENABLED=false
export OPERATING_MODE=DEMO

REPO="${VS_REPO:-/root/VS}"
PREFIX="${VS_SERVER_PREFIX:-/opt/vs-server}"
DATA="${VS_SERVER_DATA:-/var/lib/vs-server}"
LOG="${VS_SERVER_LOG:-/var/log/vs-server}"
DB_PASS="${VS_DB_PASSWORD:-vsdemo123}"

echo "========================================"
echo " VS SERVER — LAUNCH_ALL"
echo "========================================"

# -------------------------------------------------------------------------
# 1) Packages (no Docker)
# -------------------------------------------------------------------------
apt-get update -y
apt-get install -y --no-install-recommends \
  ca-certificates curl git rsync jq openssl \
  iproute2 iptables nftables ufw \
  wireguard wireguard-tools \
  postgresql postgresql-contrib redis-server \
  python3

# Node 20+
if ! command -v node >/dev/null 2>&1 || [[ "$(node -v | sed 's/v//;s/\..*//')" -lt 20 ]]; then
  apt-get install -y nodejs npm 2>/dev/null || true
  if ! command -v node >/dev/null 2>&1 || [[ "$(node -v | sed 's/v//;s/\..*//')" -lt 20 ]]; then
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
  fi
fi
echo "NODE=$(node -v) NPM=$(npm -v)"

systemctl enable --now postgresql redis-server 2>/dev/null || true
systemctl enable --now systemd-timesyncd 2>/dev/null || true
timedatectl set-ntp true 2>/dev/null || true
update-ca-certificates 2>/dev/null || true

# -------------------------------------------------------------------------
# 2) Repo
# -------------------------------------------------------------------------
if [[ ! -d "$REPO/.git" ]]; then
  GIT_SSL_NO_VERIFY=1 git clone https://github.com/voldis1994/VS.git "$REPO" \
    || git clone https://github.com/voldis1994/VS.git "$REPO"
fi
cd "$REPO"
git fetch origin 2>/dev/null || true
git checkout cursor/first-boot-debian-wifi-0bd7 2>/dev/null || git checkout main
git pull --ff-only 2>/dev/null || true

chmod +x SERVER/INSTALL_SERVER SERVER/START_SERVER SERVER/STOP_SERVER SERVER/STATUS_SERVER \
  SERVER/LAUNCH_ALL SERVER/network/* SERVER/deploy/*.sh 2>/dev/null || true

# -------------------------------------------------------------------------
# 3) Secrets + .env
# -------------------------------------------------------------------------
ENV_FILE="$REPO/.env"
cp -n "$REPO/.env.example" "$ENV_FILE" 2>/dev/null || touch "$ENV_FILE"
MASTER="$(openssl rand -hex 32)"
ADMIN="$(openssl rand -hex 24)"
JWT="$(openssl rand -hex 24)"

put() {
  local k="$1" v="$2"
  if grep -qE "^${k}=" "$ENV_FILE" 2>/dev/null; then
    sed -i "s|^${k}=.*|${k}=${v}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$k" "$v" >>"$ENV_FILE"
  fi
}

# Only rotate empty/CHANGE_ME keys; keep existing strong secrets
cur_master="$(grep -E '^MASTER_ENCRYPTION_KEY=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
cur_admin="$(grep -E '^API_ADMIN_TOKEN=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
[[ -z "$cur_master" || "$cur_master" == *CHANGE_ME* || ${#cur_master} -lt 16 ]] && put MASTER_ENCRYPTION_KEY "$MASTER"
[[ -z "$cur_admin" || "$cur_admin" == *CHANGE_ME* || ${#cur_admin} -lt 8 ]] && put API_ADMIN_TOKEN "$ADMIN"
put JWT_SECRET "$JWT"
# keep existing non-placeholder JWT
cur_jwt="$(grep -E '^JWT_SECRET=' "$ENV_FILE" 2>/dev/null | cut -d= -f2- || true)"
if [[ -n "$cur_jwt" && "$cur_jwt" != *CHANGE_ME* && ${#cur_jwt} -ge 8 ]]; then
  : # already set by put above if empty — re-read after first put
fi
# Prefer preserving strong existing JWT written earlier in file history:
if [[ -n "$cur_jwt" && "$cur_jwt" != *CHANGE_ME* && ${#cur_jwt} -ge 16 ]]; then
  put JWT_SECRET "$cur_jwt"
fi

put DB_HOST 127.0.0.1
put DB_PORT 5432
put DB_NAME market_reader
put DB_USER market_reader
put DB_PASSWORD "$DB_PASS"
put OPERATING_MODE DEMO
put LIVE_TRADING_ENABLED false
put VS_PRIVATE_NETWORK 1
put CONTROL_API_HOST 10.77.0.1
put CONTROL_API_PORT 3000
chmod 600 "$ENV_FILE"
set -a
# shellcheck disable=SC1090
source "$ENV_FILE"
set +a

# -------------------------------------------------------------------------
# 4) Local Postgres (no Docker)
# -------------------------------------------------------------------------
sudo -u postgres psql -v ON_ERROR_STOP=0 -c "CREATE USER market_reader WITH PASSWORD '${DB_PASS}';" || true
sudo -u postgres psql -v ON_ERROR_STOP=0 -c "ALTER USER market_reader WITH PASSWORD '${DB_PASS}';" || true
sudo -u postgres psql -v ON_ERROR_STOP=0 -c "CREATE DATABASE market_reader OWNER market_reader;" || true
sudo -u postgres psql -v ON_ERROR_STOP=0 -c "GRANT ALL PRIVILEGES ON DATABASE market_reader TO market_reader;" || true
# pg_hba: ensure local password auth works for TCP
if [[ -d /etc/postgresql ]]; then
  for f in /etc/postgresql/*/main/pg_hba.conf; do
    [[ -f "$f" ]] || continue
    if ! grep -q 'market_reader' "$f"; then
      echo "host market_reader market_reader 127.0.0.1/32 scram-sha-256" >>"$f"
      echo "host market_reader market_reader ::1/128 scram-sha-256" >>"$f"
    fi
  done
  systemctl reload postgresql || systemctl restart postgresql
fi
sleep 1
PGPASSWORD="$DB_PASS" psql -h 127.0.0.1 -U market_reader -d market_reader -c 'SELECT 1' >/dev/null
echo "SUCCESS: Postgres OK"

# Ensure tsx exists (INSTALL may use --omit=dev)
if [[ ! -x "$REPO/SERVER/control-api/node_modules/.bin/tsx" ]]; then
  (cd "$REPO/SERVER/control-api" && npm install --no-save tsx)
fi

# -------------------------------------------------------------------------
# 5) INSTALL_SERVER
# -------------------------------------------------------------------------
cd "$REPO/SERVER"
./INSTALL_SERVER

mkdir -p "$DATA" "$LOG" "$PREFIX/control-api"
cp -a "$ENV_FILE" "$PREFIX/control-api/.env"
cp -a "$ENV_FILE" "$PREFIX/.env" 2>/dev/null || true
cp -a "$ENV_FILE" /opt/.env 2>/dev/null || true

cat >"$DATA/server.env" <<EOF
OPERATING_MODE=DEMO
LIVE_TRADING_ENABLED=false
VS_PRIVATE_NETWORK=1
CONTROL_API_HOST=10.77.0.1
CONTROL_API_PORT=3000
VS_WG_INTERFACE=vs0
VS_WG_LISTEN_PORT=51820
VS_SERVER_ID=VS-CORE-01
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=market_reader
DB_USER=market_reader
DB_PASSWORD=${DB_PASSWORD}
MASTER_ENCRYPTION_KEY=${MASTER_ENCRYPTION_KEY}
API_ADMIN_TOKEN=${API_ADMIN_TOKEN}
JWT_SECRET=${JWT_SECRET}
NODE_ENV=production
VS_SERVER_DATA=${DATA}
VS_CORE_DATA=${DATA}
EOF
chmod 600 "$DATA/server.env" "$PREFIX/control-api/.env"
chown -R vs-server:vs-server "$DATA" "$LOG" 2>/dev/null || true

# Ensure systemd EnvironmentFile
UNIT=/etc/systemd/system/vs-server.service
if [[ -f "$UNIT" ]] && ! grep -q 'EnvironmentFile=.*server.env' "$UNIT"; then
  sed -i '/\[Service\]/a EnvironmentFile=-/var/lib/vs-server/server.env' "$UNIT"
  systemctl daemon-reload
fi

# -------------------------------------------------------------------------
# 6) Private network + firewall + WireGuard (Address= stripped for wg setconf)
# -------------------------------------------------------------------------
set -a
# shellcheck disable=SC1090
source "$DATA/server.env"
set +a

export VS_SETUP_NONINTERACTIVE=1
export VS_SETUP_CREATE_ADMIN=Y
export VS_SERVER_DATA="$DATA"
export VS_CORE_DATA="$DATA"

"$PREFIX/network/SETUP_PRIVATE_NETWORK" || "$REPO/SERVER/network/SETUP_PRIVATE_NETWORK"
"$PREFIX/network/APPLY_FIREWALL" || "$REPO/SERVER/network/APPLY_FIREWALL"

# Prefer fixed UP_WIREGUARD from repo (strips Address=)
UP_WG="$REPO/SERVER/network/UP_WIREGUARD"
[[ -x "$PREFIX/network/UP_WIREGUARD" ]] && cp -a "$UP_WG" "$PREFIX/network/UP_WIREGUARD"
VS_SERVER_DATA="$DATA" bash "$UP_WG"

# -------------------------------------------------------------------------
# 7) Start SERVER (always VS_SERVER_DATA=/var/lib/vs-server)
# -------------------------------------------------------------------------
# Kill stale nohup
if [[ -f "$DATA/vs-server.pid" ]]; then
  old="$(cat "$DATA/vs-server.pid" || true)"
  [[ -n "$old" ]] && kill "$old" 2>/dev/null || true
  rm -f "$DATA/vs-server.pid"
fi
pkill -f 'runAppliance.ts' 2>/dev/null || true
sleep 1

set -a
# shellcheck disable=SC1090
source "$DATA/server.env"
set +a
export VS_SERVER_DATA="$DATA"
export VS_CORE_DATA="$DATA"
export LIVE_TRADING_ENABLED=false
export OPERATING_MODE=DEMO

# Try systemd first
systemctl enable vs-server.service 2>/dev/null || true
if systemctl restart vs-server.service 2>/dev/null; then
  echo "INFO: systemd vs-server started"
else
  echo "INFO: systemd failed — START_SERVER nohup"
  VS_SERVER_DATA="$DATA" VS_CORE_DATA="$DATA" "$PREFIX/START_SERVER" \
    || VS_SERVER_DATA="$DATA" VS_CORE_DATA="$DATA" "$REPO/SERVER/START_SERVER"
fi

ok=0
for i in $(seq 1 60); do
  if curl -fsS http://127.0.0.1:3000/health >/dev/null 2>&1 \
    || curl -fsS http://10.77.0.1:3000/health >/dev/null 2>&1; then
    ok=1
    break
  fi
  sleep 1
done

echo
VS_SERVER_DATA="$DATA" "$PREFIX/STATUS_SERVER" 2>/dev/null \
  || VS_SERVER_DATA="$DATA" "$REPO/SERVER/STATUS_SERVER" || true
echo
echo "--- ADMIN enrollment (save this) ---"
cat "$DATA/network/issued/ADMIN_ENROLLMENT.json" 2>/dev/null || echo "(missing)"
echo
echo "API_ADMIN_TOKEN=$(grep API_ADMIN_TOKEN "$DATA/server.env" | cut -d= -f2)"
echo

if [[ "$ok" -ne 1 ]]; then
  echo "FAIL: health not up — journalctl -u vs-server -e | tail -50" >&2
  echo "      or: tail -80 $LOG/server.out /var/lib/vs-server/logs/server.out" >&2
  exit 1
fi

echo "SUCCESS: VS SERVER RUNNING (DEMO, LIVE=false)"
echo "Health: curl -fsS http://10.77.0.1:3000/health || curl -fsS http://127.0.0.1:3000/health"
exit 0
