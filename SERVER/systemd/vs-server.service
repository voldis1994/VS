[Unit]
Description=VS CORE Server (appliance)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vs/SERVER/control-api
EnvironmentFile=-/var/lib/vs-server/server.env
ExecStart=/usr/bin/env bash /opt/vs/SERVER/deploy/boot.sh
Restart=on-failure
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
