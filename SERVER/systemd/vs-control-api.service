[Unit]
Description=VS Control API (ADMIN)
PartOf=vs-server.service
After=vs-server.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/true
# Control API currently runs inside vs-server appliance process.
# Separate process split is supported via CLIENT_API_PORT when enabled.

[Install]
WantedBy=multi-user.target
