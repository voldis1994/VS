#!/usr/bin/env bash
# STOP_SERVER — stop VS SERVER runtime (not uninstall).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
DATA="${VS_SERVER_DATA:-${VS_CORE_DATA:-$ROOT/../data/vs-server}}"
PID_FILE="$DATA/vs-server.pid"

echo "VS SERVER STOP"

if systemctl is-active --quiet vs-server.service 2>/dev/null; then
  systemctl stop vs-server.service
  echo "SUCCESS: systemd vs-server stopped"
  exit 0
fi

if [[ -f "$PID_FILE" ]]; then
  pid="$(cat "$PID_FILE")"
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" || true
    sleep 1
    kill -9 "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  echo "SUCCESS: stopped pid=$pid"
  exit 0
fi

echo "SUCCESS: SERVER was not running"
exit 0
