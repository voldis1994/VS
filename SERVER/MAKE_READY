#!/usr/bin/env bash
# MAKE_READY — one shot on VS SERVER (i3): fix systemd, tsx, WG, start, print ADMIN info.
# DEMO only. LIVE stays false.
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: sudo -i  then  bash SERVER/MAKE_READY" >&2
  exit 1
fi

REPO="${VS_REPO:-/root/VS}"
PREFIX="${VS_SERVER_PREFIX:-/opt/vs-server}"
DATA="${VS_SERVER_DATA:-/var/lib/vs-server}"
LOG="${VS_SERVER_LOG:-/var/log/vs-server}"
API="$PREFIX/control-api"

echo "========================================"
echo " VS SERVER — MAKE_READY"
echo "========================================"

mkdir -p "$DATA" "$LOG" "$API"

# Sync boot + network scripts from repo if present
if [[ -d "$REPO/SERVER" ]]; then
  cp -a "$REPO/SERVER/deploy/boot.sh" "$PREFIX/deploy/boot.sh" 2>/dev/null || true
  cp -a "$REPO/SERVER/network/UP_WIREGUARD" "$PREFIX/network/UP_WIREGUARD" 2>/dev/null || true
  chmod +x "$PREFIX/deploy/boot.sh" "$PREFIX/network/"* 2>/dev/null || true
  # keep package.json with tsx in dependencies
  if [[ -f "$REPO/SERVER/control-api/package.json" ]]; then
    cp -a "$REPO/SERVER/control-api/package.json" "$API/package.json"
    [[ -f "$REPO/SERVER/control-api/package-lock.json" ]] && \
      cp -a "$REPO/SERVER/control-api/package-lock.json" "$API/package-lock.json"
  fi
fi

# Ensure secrets exist
if [[ ! -f "$DATA/server.env" ]]; then
  echo "FAIL: missing $DATA/server.env — run LAUNCH_ALL first" >&2
  exit 1
fi
set -a
# shellcheck disable=SC1090
source "$DATA/server.env"
set +a
export LIVE_TRADING_ENABLED=false
export OPERATING_MODE=DEMO
export VS_SERVER_DATA="$DATA"
export VS_CORE_DATA="$DATA"
export VS_SERVER_ROOT="$PREFIX"
export VS_CORE_ROOT="$PREFIX"

# Ensure .env for dotenv
[[ -f "$API/.env" ]] || cp -a "$DATA/server.env" "$API/.env"
chmod 600 "$DATA/server.env" "$API/.env"

# Install/repair node deps + tsx
cd "$API"
if [[ ! -x node_modules/.bin/tsx ]]; then
  echo "==> npm install (tsx required)"
  npm install
fi
test -x node_modules/.bin/tsx

# WireGuard
if ! ip -4 addr show dev "${VS_WG_INTERFACE:-vs0}" 2>/dev/null | grep -q 'inet '; then
  echo "==> UP_WIREGUARD"
  VS_SERVER_DATA="$DATA" bash "$PREFIX/network/UP_WIREGUARD" \
    || VS_SERVER_DATA="$DATA" bash "$REPO/SERVER/network/UP_WIREGUARD"
fi
ip -br a show "${VS_WG_INTERFACE:-vs0}" || true

# systemd unit — always EnvironmentFile + boot.sh
cat >/etc/systemd/system/vs-server.service <<EOF
[Unit]
Description=VS SERVER appliance
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=${PREFIX}
EnvironmentFile=-${DATA}/server.env
Environment=VS_SERVER_ROOT=${PREFIX}
Environment=VS_CORE_ROOT=${PREFIX}
Environment=VS_SERVER_DATA=${DATA}
Environment=VS_CORE_DATA=${DATA}
Environment=NODE_ENV=production
Environment=OPERATING_MODE=DEMO
Environment=LIVE_TRADING_ENABLED=false
Environment=CONTROL_API_HOST=10.77.0.1
Environment=CONTROL_API_PORT=3000
ExecStart=${PREFIX}/deploy/boot.sh
Restart=on-failure
RestartSec=5
MemoryMax=4G
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
systemctl enable vs-server.service

# Stop manual leftovers, start systemd
pkill -f 'runAppliance.ts' 2>/dev/null || true
sleep 1
systemctl restart vs-server.service

ok=0
for i in $(seq 1 45); do
  if curl -fsS http://10.77.0.1:3000/health >/dev/null 2>&1 \
    || curl -fsS http://127.0.0.1:3000/health >/dev/null 2>&1; then
    ok=1
    break
  fi
  sleep 1
done

echo
systemctl --no-pager -l status vs-server | head -20 || true
echo
curl -fsS http://10.77.0.1:3000/health || curl -fsS http://127.0.0.1:3000/health || true
echo
echo "======== SAVE THESE ========"
echo "API_ADMIN_TOKEN=$(grep -E '^API_ADMIN_TOKEN=' "$DATA/server.env" | cut -d= -f2-)"
if [[ -f "$DATA/network/issued/ADMIN_ENROLLMENT.json" ]]; then
  echo "ENROLLMENT_JSON=$DATA/network/issued/ADMIN_ENROLLMENT.json"
  jq -r '"enrollment_code=" + .enrollment_code' "$DATA/network/issued/ADMIN_ENROLLMENT.json" 2>/dev/null \
    || grep enrollment_code "$DATA/network/issued/ADMIN_ENROLLMENT.json"
fi
echo "============================"

if [[ "$ok" -ne 1 ]]; then
  echo "FAIL: health not up" >&2
  journalctl -u vs-server -n 40 --no-pager >&2 || true
  exit 1
fi

echo "SUCCESS: SERVER ready via systemd (DEMO, LIVE=false)"
echo "Next on ADMIN PC: bash ADMIN/LAUNCH_ADMIN"
exit 0
