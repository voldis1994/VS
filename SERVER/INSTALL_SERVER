#!/usr/bin/env bash
# INSTALL_SERVER — one-time system setup for VS SERVER (i3 appliance).
# NOT a runtime launcher. Does not start trading blindly as READY.
set -euo pipefail

ROOT="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$ROOT/.." && pwd)"
PREFIX="${VS_SERVER_PREFIX:-${VS_CORE_PREFIX:-/opt/vs-server}}"
DATA="${VS_SERVER_DATA:-${VS_CORE_DATA:-/var/lib/vs-server}}"
LOG="${VS_SERVER_LOG:-${VS_CORE_LOG:-/var/log/vs-server}}"

echo "VS SERVER INSTALL"
echo "ROOT=$ROOT"
echo "PREFIX=$PREFIX"

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: INSTALL_SERVER requires root" >&2
  exit 1
fi

# OS check
if [[ ! -f /etc/os-release ]]; then
  echo "FAIL: unsupported OS (no /etc/os-release)" >&2
  exit 1
fi

# Dependencies
need=(rsync systemctl)
for c in "${need[@]}"; do
  if ! command -v "$c" >/dev/null 2>&1; then
    echo "FAIL: missing dependency: $c" >&2
    exit 1
  fi
done
if ! command -v node >/dev/null 2>&1; then
  echo "FAIL: Node.js required (20+)" >&2
  exit 1
fi

id -u vs-server >/dev/null 2>&1 || useradd --system --home "$DATA" --shell /usr/sbin/nologin vs-server
# compat alias user
id -u vs-core >/dev/null 2>&1 || useradd --system --home "$DATA" --shell /usr/sbin/nologin vs-core

mkdir -p "$PREFIX" "$DATA" "$LOG" "$DATA/market" "$DATA/backup" "$DATA/updates" "$DATA/orders" "$DATA/admin" \
  "$DATA/network" "$DATA/network/keys" "$DATA/network/issued"
# Idempotent: never wipe existing registry/keys on re-install
if [[ -f "$DATA/network/device-registry.json" ]]; then
  echo "INFO: existing device registry preserved (idempotent INSTALL_SERVER)"
fi
rsync -a --delete \
  --exclude .git \
  --exclude node_modules \
  --exclude '**/node_modules' \
  "$ROOT/" "$PREFIX/"

# WireGuard tools (soft requirement — EXTERNAL until installed)
if ! command -v wg >/dev/null 2>&1; then
  echo "WARN: wireguard-tools not installed — install wireguard wireguard-tools before UP_WIREGUARD"
fi

# Install control-api deps into prefix
# NOTE: runtime still executes TypeScript via tsx — do NOT omit it (not a pure build artifact yet).
if [[ -f "$PREFIX/control-api/package.json" ]]; then
  (cd "$PREFIX/control-api" && npm ci --omit=dev && npm install --no-save --no-package-lock tsx)
fi

chown -R vs-server:vs-server "$DATA" "$LOG"
chown -R vs-server:vs-server "$PREFIX"

UNIT_SRC="$PREFIX/deploy/systemd"
if [[ -d "$UNIT_SRC" ]]; then
  # Rewrite unit paths for SERVER layout
  sed "s|/opt/vs-core|$PREFIX|g; s|VS_CORE_|VS_SERVER_|g; s|User=vs-core|User=vs-server|g" \
    "$UNIT_SRC/vs-core.service" >/etc/systemd/system/vs-server.service
  sed "s|/opt/vs-core|$PREFIX|g" \
    "$UNIT_SRC/vs-watchdog.service" >/etc/systemd/system/vs-server-watchdog.service
  sed "s|vs-watchdog|vs-server-watchdog|g; s|vs-core|vs-server|g" \
    "$UNIT_SRC/vs-watchdog.timer" >/etc/systemd/system/vs-server-watchdog.timer
  # Always load durable secrets/runtime from data dir
  if ! grep -q 'EnvironmentFile=.*server.env' /etc/systemd/system/vs-server.service; then
    sed -i '/\[Service\]/a EnvironmentFile=-/var/lib/vs-server/server.env' \
      /etc/systemd/system/vs-server.service
  fi
fi

chmod +x "$PREFIX/INSTALL_SERVER" "$PREFIX/START_SERVER" "$PREFIX/STOP_SERVER" "$PREFIX/STATUS_SERVER" \
  "$PREFIX/FIX_WIFI" "$PREFIX/FIRST_BOOT_DEBIAN" "$PREFIX/LAUNCH_ALL" \
  "$PREFIX/deploy/boot.sh" \
  "$PREFIX/network/"* 2>/dev/null || true

systemctl daemon-reload
systemctl enable vs-server.service vs-server-watchdog.timer 2>/dev/null || true

# Never write secrets into the tree
if [[ ! -f "$DATA/server.env" ]]; then
  cat >"$DATA/server.env" <<'EOF'
# VS SERVER runtime env — edit on host; never commit secrets
OPERATING_MODE=DEMO
LIVE_TRADING_ENABLED=false
VS_PRIVATE_NETWORK=1
CONTROL_API_HOST=10.77.0.1
CONTROL_API_PORT=3000
VS_WG_INTERFACE=vs0
VS_WG_LISTEN_PORT=51820
VS_SERVER_ID=VS-CORE-01
# DDNS / public hostname foundation (not hardcoded public IP):
# VS_SERVER_ENDPOINT_HOSTNAME=vs-core-01.example.com
# Required before START_SERVER (FIRST_BOOT_DEBIAN generates these):
# MASTER_ENCRYPTION_KEY=
# API_ADMIN_TOKEN=
# DB_HOST=127.0.0.1
# DB_PASSWORD=
EOF
  chown vs-server:vs-server "$DATA/server.env"
  chmod 0600 "$DATA/server.env"
fi

echo "SUCCESS: VS SERVER installed at $PREFIX"
echo "Preferred first boot: sudo $PREFIX/FIRST_BOOT_DEBIAN"
echo "Or manual: SETUP_PRIVATE_NETWORK → APPLY_FIREWALL → UP_WIREGUARD → START_SERVER"
echo "NOTE: VS_PRIVATE_NETWORK=1 is fail-closed — WG must be READY (no public HTTP fallback)"
exit 0
