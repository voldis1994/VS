#!/usr/bin/env bash
# =============================================================================
# INSTALL_I3_SERVER — ONE authoritative installer for VS SERVER on dedicated i3
# =============================================================================
# Clean Debian/Ubuntu Linux. Idempotent. Does NOT enable LIVE trading.
#
#   sudo bash SERVER/INSTALL_I3_SERVER
#
# Architecture:
#   MSI Control Panel (LAN)  →  http://<i3-lan-ip>:3000  (ADMIN)
#   Customer web portal      →  http://<i3-lan-ip>:3000/ (login+password from ADMIN)
#   Postgres/Redis           →  127.0.0.1 only (Docker)
# =============================================================================
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: run as root:  sudo bash $0" >&2
  exit 1
fi

export DEBIAN_FRONTEND=noninteractive
export LIVE_TRADING_ENABLED=false
# Infrastructure mode — not a fake "demo install"; LIVE stays fail-closed
export OPERATING_MODE="${OPERATING_MODE:-PRODUCTION}"

HERE="$(cd "$(dirname "$0")" && pwd)"
REPO="$(cd "$HERE/.." && pwd)"
PREFIX="${VS_SERVER_PREFIX:-/opt/vs-server}"
DATA="${VS_SERVER_DATA:-/var/lib/vs-server}"
LOG="${VS_SERVER_LOG:-/var/log/vs-server}"
API="$PREFIX/control-api"
RUN_USER="${VS_SERVER_USER:-vs-server}"

LAN_IP="$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}' || true)"
export VS_SERVER_ENDPOINT_IP="${VS_SERVER_ENDPOINT_IP:-$LAN_IP}"
export VS_SERVER_LAN_IP="${VS_SERVER_LAN_IP:-$LAN_IP}"

echo "========================================"
echo " VS SERVER — INSTALL_I3_SERVER"
echo " REPO=$REPO"
echo " PREFIX=$PREFIX DATA=$DATA"
echo " LAN_IP=${LAN_IP:-UNKNOWN}"
echo " LIVE_TRADING_ENABLED=false  MODE=$OPERATING_MODE"
echo "========================================"

# ---------------------------------------------------------------------------
# 1) OS packages
# ---------------------------------------------------------------------------
apt-get update -y
apt-get install -y --no-install-recommends \
  ca-certificates curl git rsync jq openssl \
  iproute2 iptables nftables ufw \
  wireguard wireguard-tools \
  docker.io \
  postgresql-client

# Compose plugin (name varies)
apt-get install -y docker-compose-plugin 2>/dev/null \
  || apt-get install -y docker-compose-v2 2>/dev/null \
  || apt-get install -y docker-compose 2>/dev/null \
  || true

systemctl enable --now docker
systemctl enable --now systemd-timesyncd 2>/dev/null || true
timedatectl set-ntp true 2>/dev/null || true
update-ca-certificates 2>/dev/null || true

# Node 20+
need_node=0
if ! command -v node >/dev/null 2>&1; then need_node=1; else
  [[ "$(node -v | sed 's/^v//;s/\..*//')" -lt 20 ]] && need_node=1
fi
if [[ "$need_node" -eq 1 ]]; then
  apt-get install -y nodejs npm 2>/dev/null || true
  if ! command -v node >/dev/null 2>&1 || [[ "$(node -v | sed 's/^v//;s/\..*//')" -lt 20 ]]; then
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
  fi
fi
echo "NODE=$(node -v) DOCKER=$(docker --version 2>/dev/null | head -1)"

# ---------------------------------------------------------------------------
# 2) Service user + dirs
# ---------------------------------------------------------------------------
id -u "$RUN_USER" >/dev/null 2>&1 || useradd --system --home "$DATA" --shell /usr/sbin/nologin "$RUN_USER"
id -u vs-core >/dev/null 2>&1 || useradd --system --home "$DATA" --shell /usr/sbin/nologin vs-core
usermod -aG docker "$RUN_USER" 2>/dev/null || true

mkdir -p "$PREFIX" "$DATA" "$LOG" \
  "$DATA/market" "$DATA/backup" "$DATA/updates" "$DATA/orders" "$DATA/admin" \
  "$DATA/network/keys" "$DATA/network/issued" "$DATA/logs"

# ---------------------------------------------------------------------------
# 3) Secrets (idempotent — never rotate existing strong keys)
# ---------------------------------------------------------------------------
ENV_ROOT="$REPO/.env"
ENV_API="$API/.env"
SERVER_ENV="$DATA/server.env"

gen() { openssl rand -hex "$1"; }

ensure_kv() {
  local f="$1" k="$2" v="$3"
  touch "$f"
  if grep -qE "^${k}=" "$f" 2>/dev/null; then
    local cur
    cur="$(grep -E "^${k}=" "$f" | head -1 | cut -d= -f2-)"
    if [[ -z "$cur" || "$cur" == *CHANGE_ME* || ${#cur} -lt 8 ]]; then
      sed -i "s|^${k}=.*|${k}=${v}|" "$f"
    fi
  else
    printf '%s=%s\n' "$k" "$v" >>"$f"
  fi
}

# Force-rewrite keys that must not linger from older WG-only installs
force_kv() {
  local f="$1" k="$2" v="$3"
  touch "$f"
  if grep -qE "^${k}=" "$f" 2>/dev/null; then
    sed -i "s|^${k}=.*|${k}=${v}|" "$f"
  else
    printf '%s=%s\n' "$k" "$v" >>"$f"
  fi
}

[[ -f "$ENV_ROOT" ]] || cp "$REPO/.env.example" "$ENV_ROOT" 2>/dev/null || touch "$ENV_ROOT"

DB_PASS="$(gen 16)"
MASTER="$(gen 32)"
ADMIN="$(gen 24)"
JWT="$(gen 24)"

ensure_kv "$ENV_ROOT" DB_HOST 127.0.0.1
ensure_kv "$ENV_ROOT" DB_PORT 5432
ensure_kv "$ENV_ROOT" DB_NAME market_reader
ensure_kv "$ENV_ROOT" DB_USER market_reader
ensure_kv "$ENV_ROOT" DB_PASSWORD "$DB_PASS"
ensure_kv "$ENV_ROOT" MASTER_ENCRYPTION_KEY "$MASTER"
ensure_kv "$ENV_ROOT" API_ADMIN_TOKEN "$ADMIN"
ensure_kv "$ENV_ROOT" JWT_SECRET "$JWT"
ensure_kv "$ENV_ROOT" OPERATING_MODE "$OPERATING_MODE"
ensure_kv "$ENV_ROOT" LIVE_TRADING_ENABLED false
ensure_kv "$ENV_ROOT" VS_PRIVATE_NETWORK 1
ensure_kv "$ENV_ROOT" VS_LAN_MANAGEMENT 1
ensure_kv "$ENV_ROOT" CONTROL_API_HOST 0.0.0.0
ensure_kv "$ENV_ROOT" CONTROL_API_PORT 3000
ensure_kv "$ENV_ROOT" CONTROL_API_URL "http://127.0.0.1:3000"
ensure_kv "$ENV_ROOT" CORS_ORIGIN "*"
ensure_kv "$ENV_ROOT" VS_WG_LISTEN_PORT 51820
ensure_kv "$ENV_ROOT" VS_SERVER_ENDPOINT_IP "${LAN_IP:-}"
# CRITICAL: always overwrite bind/LAN flags (ensure_kv would keep stale 10.77.0.1)
force_kv "$ENV_ROOT" CONTROL_API_HOST 0.0.0.0
force_kv "$ENV_ROOT" VS_LAN_MANAGEMENT 1
force_kv "$ENV_ROOT" VS_PRIVATE_NETWORK 1
force_kv "$ENV_ROOT" CONTROL_API_URL "http://127.0.0.1:3000"
chmod 640 "$ENV_ROOT"
chown root:"$RUN_USER" "$ENV_ROOT" 2>/dev/null || chmod 600 "$ENV_ROOT"

set -a
# shellcheck disable=SC1090
source <(grep -E '^[A-Z0-9_]+=' "$ENV_ROOT" | sed 's/\r$//')
set +a

# Durable server.env for systemd
cat >"$SERVER_ENV" <<EOF
# Generated/updated by INSTALL_I3_SERVER — do not commit
NODE_ENV=production
OPERATING_MODE=${OPERATING_MODE}
LIVE_TRADING_ENABLED=false
VS_PRIVATE_NETWORK=1
VS_LAN_MANAGEMENT=1
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3000
CONTROL_API_URL=http://127.0.0.1:3000
CORS_ORIGIN=*
VS_WG_INTERFACE=vs0
VS_WG_LISTEN_PORT=51820
VS_SERVER_ID=VS-CORE-01
VS_SERVER_ENDPOINT_IP=${LAN_IP:-}
VS_SERVER_LAN_IP=${LAN_IP:-}
VS_SERVER_ENDPOINT_HOSTNAME=${VS_SERVER_ENDPOINT_HOSTNAME:-}
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=${DB_NAME}
DB_USER=${DB_USER}
DB_PASSWORD=${DB_PASSWORD}
MASTER_ENCRYPTION_KEY=${MASTER_ENCRYPTION_KEY}
API_ADMIN_TOKEN=${API_ADMIN_TOKEN}
JWT_SECRET=${JWT_SECRET}
VS_SERVER_ROOT=${PREFIX}
VS_CORE_ROOT=${PREFIX}
VS_SERVER_DATA=${DATA}
VS_CORE_DATA=${DATA}
EOF
chmod 640 "$SERVER_ENV"
chown root:"$RUN_USER" "$SERVER_ENV"
# Secrets stay group-readable by vs-server only — never world-readable, never 777.
# Physical monitor must NOT source this file; it uses localhost console API.

# ---------------------------------------------------------------------------
# 4) Docker Postgres + Redis (wait until READY)
# ---------------------------------------------------------------------------
cd "$REPO"
if ! docker compose version >/dev/null 2>&1 && ! docker-compose version >/dev/null 2>&1; then
  echo "FAIL: docker compose not available after apt install" >&2
  exit 1
fi

compose() {
  if docker compose version >/dev/null 2>&1; then docker compose "$@"
  else docker-compose "$@"
  fi
}

# Stable project name so re-installs adopt the same stack
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-vs-server}"

ensure_named_container() {
  local name="$1"
  if docker inspect "$name" >/dev/null 2>&1; then
    local st
    st="$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null || echo missing)"
    if [[ "$st" != "running" ]]; then
      echo "INFO: starting existing container $name (was $st)"
      docker start "$name" >/dev/null
    else
      echo "INFO: reusing running container $name"
    fi
    return 0
  fi
  return 1
}

echo "==> docker compose up -d (postgres+redis on 127.0.0.1)"
# Prefer reuse of already-created appliance containers (common on re-install)
pg_exists=0
rd_exists=0
ensure_named_container market-reader-postgres && pg_exists=1 || true
ensure_named_container market-reader-redis && rd_exists=1 || true

compose_err="$(mktemp)"
set +e
compose up -d >"$compose_err" 2>&1
compose_rc=$?
set -e
if [[ "$compose_rc" -ne 0 ]]; then
  if grep -qiE 'already in use|Conflict' "$compose_err"; then
    echo "WARN: docker name conflict — adopting existing market-reader-* containers"
    cat "$compose_err" | tail -20 || true
    docker start market-reader-postgres >/dev/null 2>&1 || true
    docker start market-reader-redis >/dev/null 2>&1 || true
  else
    echo "FAIL: docker compose up failed:" >&2
    cat "$compose_err" >&2
    rm -f "$compose_err"
    exit 1
  fi
else
  cat "$compose_err" || true
fi
rm -f "$compose_err"

# Persist compose files for reboot (systemd ExecStartPre)
cp -a "$REPO/SERVER/database/docker-compose.yml" "$DATA/docker-compose.yml"
cp -a "$ENV_ROOT" "$DATA/compose.env"
chmod 600 "$DATA/compose.env"
chown root:"$RUN_USER" "$DATA/compose.env" 2>/dev/null || true

echo "==> waiting for Postgres readiness"
ok_pg=0
for i in $(seq 1 90); do
  if docker exec market-reader-postgres pg_isready -U "${DB_USER}" -d "${DB_NAME}" >/dev/null 2>&1; then
    ok_pg=1
    break
  fi
  sleep 1
done
[[ "$ok_pg" -eq 1 ]] || { echo "FAIL: Postgres not ready" >&2; exit 1; }
echo "SUCCESS: Postgres READY"
echo "==> sync DB password into volume (prevent 28P01)"
bash "$HERE/deploy/fix-db-password.sh"

ok_rd=0
for i in $(seq 1 30); do
  if docker exec market-reader-redis redis-cli ping 2>/dev/null | grep -q PONG; then
    ok_rd=1
    break
  fi
  sleep 1
done
[[ "$ok_rd" -eq 1 ]] || echo "WARN: Redis not ready (optional)"

# ---------------------------------------------------------------------------
# 5) Install tree + npm as vs-server (never leave root-owned node_modules)
# ---------------------------------------------------------------------------
echo "==> rsync → $PREFIX"
rsync -a --delete \
  --exclude .git \
  --exclude node_modules \
  --exclude '**/node_modules' \
  "$HERE/" "$PREFIX/"

mkdir -p "$API"
cp -a "$ENV_ROOT" "$API/.env"
cp -a "$ENV_ROOT" "$PREFIX/.env" 2>/dev/null || true
cp -a "$ENV_ROOT" /opt/.env
# Force bind after copy — never leave stale WG-only host in runtime .env
force_kv "$API/.env" CONTROL_API_HOST 0.0.0.0
force_kv "$API/.env" VS_LAN_MANAGEMENT 1
force_kv "$API/.env" VS_PRIVATE_NETWORK 1
force_kv "$PREFIX/.env" CONTROL_API_HOST 0.0.0.0 2>/dev/null || true
chmod 600 "$API/.env" /opt/.env
chown root:"$RUN_USER" "$API/.env" 2>/dev/null || true

chown -R "$RUN_USER:$RUN_USER" "$DATA" "$LOG" "$PREFIX"

echo "==> npm ci as $RUN_USER (control-api + tsx runtime)"
sudo -u "$RUN_USER" bash -lc "cd '$API' && (npm ci || npm install)"
# tsx is a production dependency; verify binary hard-fail
if [[ ! -x "$API/node_modules/.bin/tsx" ]]; then
  echo "==> tsx binary missing after npm ci — installing tsx explicitly"
  sudo -u "$RUN_USER" bash -lc "cd '$API' && npm install tsx@^4.19.0 --save"
fi
if [[ ! -x "$API/node_modules/.bin/tsx" && ! -d "$API/node_modules/tsx" ]]; then
  echo "FAIL: tsx not installed under $API/node_modules — monitor/boot cannot start" >&2
  exit 1
fi
# Prove local runtime resolves without global npm
if ! sudo -u "$RUN_USER" bash -lc "cd '$API' && ./node_modules/.bin/tsx --version" >/dev/null 2>&1 \
   && ! sudo -u "$RUN_USER" bash -lc "cd '$API' && node --import tsx -e 'console.log(1)'" >/dev/null 2>&1; then
  echo "FAIL: local tsx runtime does not execute" >&2
  exit 1
fi
echo "SUCCESS: local tsx runtime OK ($API/node_modules/.bin/tsx)"

echo "==> validate market-intelligence contract before client build / systemd"
chmod +x "$PREFIX/deploy/validate-mi-contract.sh" 2>/dev/null || true
bash "$PREFIX/deploy/validate-mi-contract.sh"

# Record build identity for /health
BUILD_SHA="$(git -C "$REPO" rev-parse --short HEAD 2>/dev/null || echo unknown)"
BUILD_TIME="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
force_kv "$SERVER_ENV" BUILD_SHA "$BUILD_SHA"
force_kv "$SERVER_ENV" BUILD_TIME "$BUILD_TIME"
force_kv "$SERVER_ENV" VS_SERVER_ID VS-CORE-01
force_kv "$API/.env" BUILD_SHA "$BUILD_SHA"
force_kv "$API/.env" BUILD_TIME "$BUILD_TIME"

# Client web portal (login / market / lot / robot) — served at http://SERVER:3000/
CLIENT_SRC="$REPO/CLIENT/desktop"
CLIENT_DIST="$PREFIX/client-panel"
if [[ -f "$CLIENT_SRC/package.json" ]]; then
  echo "==> Build CLIENT web panel → $CLIENT_DIST"
  mkdir -p "$CLIENT_DIST" "$PREFIX/client-panel-src"
  rsync -a --delete --exclude node_modules --exclude dist "$CLIENT_SRC/" "$PREFIX/client-panel-src/"
  chown -R "$RUN_USER:$RUN_USER" "$PREFIX/client-panel-src"
  sudo -u "$RUN_USER" bash -lc "cd '$PREFIX/client-panel-src' && (npm ci || npm install) && npm run build"
  rsync -a --delete "$PREFIX/client-panel-src/dist/" "$CLIENT_DIST/"
  chown -R "$RUN_USER:$RUN_USER" "$CLIENT_DIST"
  ensure_kv "$ENV_ROOT" CLIENT_PANEL_DIST "$CLIENT_DIST"
  if grep -q '^CLIENT_PANEL_DIST=' "$SERVER_ENV" 2>/dev/null; then
    sed -i "s|^CLIENT_PANEL_DIST=.*|CLIENT_PANEL_DIST=$CLIENT_DIST|" "$SERVER_ENV"
  else
    echo "CLIENT_PANEL_DIST=$CLIENT_DIST" >>"$SERVER_ENV"
  fi
  echo "CLIENT panel ready: $CLIENT_DIST"
else
  echo "WARN: $CLIENT_SRC missing — web panel not built"
fi

# ---------------------------------------------------------------------------
# 6) Private network foundation + firewall + WireGuard
# ---------------------------------------------------------------------------
chmod +x "$PREFIX"/INSTALL_* "$PREFIX"/START_* "$PREFIX"/STOP_* "$PREFIX"/STATUS_* \
  "$PREFIX"/RESTART_* "$PREFIX"/MONITOR_* "$PREFIX"/network/* "$PREFIX"/deploy/*.sh 2>/dev/null || true

# Keep INSTALL_MONITOR next to INSTALL_I3_SERVER for one-shot monitor repair
cp -a "$HERE/INSTALL_MONITOR" "$PREFIX/INSTALL_MONITOR" 2>/dev/null || true
chmod +x "$PREFIX/INSTALL_MONITOR" 2>/dev/null || true

set -a
# shellcheck disable=SC1090
source "$SERVER_ENV"
set +a

export VS_SETUP_NONINTERACTIVE=1
export VS_SETUP_CREATE_ADMIN=Y
export VS_SERVER_DATA="$DATA"
export VS_CORE_DATA="$DATA"

echo "==> SETUP_PRIVATE_NETWORK"
"$PREFIX/network/SETUP_PRIVATE_NETWORK" || true

echo "==> APPLY_FIREWALL (LAN + WG for API)"
"$PREFIX/network/APPLY_FIREWALL"

echo "==> UP_WIREGUARD"
VS_SERVER_DATA="$DATA" "$PREFIX/network/UP_WIREGUARD" || true

# ---------------------------------------------------------------------------
# 7) systemd
# ---------------------------------------------------------------------------
# Masked units are a symlink to /dev/null — writing the unit without unmask
# silently discards the file into /dev/null and leaves API dead.
systemctl stop vs-server.service 2>/dev/null || true
systemctl disable vs-server.service 2>/dev/null || true
systemctl unmask vs-server.service 2>/dev/null || true
systemctl unmask vs-server-monitor.service 2>/dev/null || true
rm -f /etc/systemd/system/vs-server.service
rm -rf /etc/systemd/system/vs-server.service.d 2>/dev/null || true
# If still a symlink somehow, force-remove
if [[ -L /etc/systemd/system/vs-server.service ]]; then
  rm -f /etc/systemd/system/vs-server.service
fi

cat >/etc/systemd/system/vs-server.service <<EOF
[Unit]
Description=VS SERVER appliance
After=network-online.target docker.service
Wants=network-online.target docker.service

[Service]
Type=simple
User=${RUN_USER}
Group=${RUN_USER}
WorkingDirectory=${PREFIX}
EnvironmentFile=-${DATA}/server.env
Environment=VS_SERVER_ROOT=${PREFIX}
Environment=VS_CORE_ROOT=${PREFIX}
Environment=VS_SERVER_DATA=${DATA}
Environment=VS_CORE_DATA=${DATA}
Environment=NODE_ENV=production
Environment=OPERATING_MODE=${OPERATING_MODE}
# LIVE_TRADING_ENABLED is NOT hardcoded here — operator value is preserved in server.env
Environment=VS_LAN_MANAGEMENT=1
Environment=VS_PRIVATE_NETWORK=1
Environment=CONTROL_API_HOST=0.0.0.0
Environment=CONTROL_API_PORT=3000
ExecStartPre=+${PREFIX}/deploy/ensure-postgres.sh
ExecStart=${PREFIX}/deploy/boot.sh
Restart=on-failure
RestartSec=5
MemoryMax=4G
LimitNOFILE=65535
SupplementaryGroups=docker
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=${DATA} ${LOG} ${PREFIX} /var/run/docker.sock

[Install]
WantedBy=multi-user.target
EOF

# Refuse to continue if unit file is still a symlink / missing
if [[ -L /etc/systemd/system/vs-server.service ]] || [[ ! -f /etc/systemd/system/vs-server.service ]]; then
  echo "FAIL: vs-server.service was not written as a real file (still masked?)" >&2
  ls -la /etc/systemd/system/vs-server.service >&2 || true
  exit 1
fi
if ! grep -q 'ExecStart=.*/deploy/boot.sh' /etc/systemd/system/vs-server.service; then
  echo "FAIL: vs-server.service content incomplete" >&2
  cat /etc/systemd/system/vs-server.service >&2
  exit 1
fi

# Convenience wrappers on PATH-ish locations
ln -sfn "$PREFIX/INSTALL_I3_SERVER" /usr/local/sbin/INSTALL_I3_SERVER 2>/dev/null || true
cp -a "$HERE/START_SERVER" "$PREFIX/START_SERVER"
cp -a "$HERE/STOP_SERVER" "$PREFIX/STOP_SERVER"
cp -a "$HERE/STATUS_SERVER" "$PREFIX/STATUS_SERVER"
cp -a "$HERE/RESTART_SERVER" "$PREFIX/RESTART_SERVER" 2>/dev/null || true
cp -a "$HERE/MONITOR_SERVER" "$PREFIX/MONITOR_SERVER"
cp -a "$HERE/SHOW_LIVE_MONITOR.sh" "$PREFIX/SHOW_LIVE_MONITOR.sh" 2>/dev/null || true
cp -a "$HERE/START_MONITOR" "$PREFIX/START_MONITOR" 2>/dev/null || true
cp -a "$HERE/STOP_MONITOR" "$PREFIX/STOP_MONITOR" 2>/dev/null || true
chmod +x "$PREFIX/MONITOR_SERVER" "$PREFIX/SHOW_LIVE_MONITOR.sh" \
  "$PREFIX/START_MONITOR" "$PREFIX/STOP_MONITOR" 2>/dev/null || true

# Global one-command monitor (works from any directory after install)
install -m 0755 "$HERE/deploy/vs-monitor" /usr/local/bin/vs-monitor
# Also keep a copy under PREFIX for PATH-less recovery
cp -a "$HERE/deploy/vs-monitor" "$PREFIX/vs-monitor"
chmod +x "$PREFIX/vs-monitor"

# Optional autostart hint for graphical/login sessions (does not block boot)
AUTOSTART_DIR="/etc/profile.d"
if [[ -d "$AUTOSTART_DIR" ]]; then
  cat >"$AUTOSTART_DIR/vs-monitor-hint.sh" <<'EOF'
# VS CORE — optional. Uncomment to auto-open monitor on interactive login TTYs.
# [[ $- == *i* && -z ${VS_MONITOR_AUTOSTART_DONE:-} && $(tty 2>/dev/null) == /dev/tty1 ]] || return 0
# export VS_MONITOR_AUTOSTART_DONE=1
# command -v vs-monitor >/dev/null 2>&1 && vs-monitor
EOF
  chmod 644 "$AUTOSTART_DIR/vs-monitor-hint.sh"
fi

# Local read-only physical console monitor (independent of vs-server lifecycle)
install -m 0644 "$HERE/deploy/systemd/vs-server-monitor.service" \
  /etc/systemd/system/vs-server-monitor.service
# Rewrite paths for this PREFIX/DATA
sed -i "s|/opt/vs-server|${PREFIX}|g; s|/var/lib/vs-server|${DATA}|g" \
  /etc/systemd/system/vs-server-monitor.service
# Headless / no console: drop TTY binding so the unit still runs to the journal
if [[ ! -e /dev/tty1 ]]; then
  sed -i \
    -e '/^TTYPath=/d' \
    -e '/^StandardInput=/d' \
    -e '/^StandardOutput=/d' \
    -e '/^TTYReset=/d' \
    -e '/^TTYVHangup=/d' \
    /etc/systemd/system/vs-server-monitor.service
  printf '%s\n' 'StandardOutput=journal' 'StandardError=journal' \
    >>/etc/systemd/system/vs-server-monitor.service
fi

systemctl daemon-reload
systemctl enable vs-server.service
systemctl restart vs-server.service

# ---------------------------------------------------------------------------
# 8) Health + MONITOR self-test (must pass or install FAILS)
# ---------------------------------------------------------------------------
ok=0
for i in $(seq 1 60); do
  if curl -fsS "http://127.0.0.1:3000/health" >/dev/null 2>&1; then ok=1; break; fi
  if [[ -n "$LAN_IP" ]] && curl -fsS "http://${LAN_IP}:3000/health" >/dev/null 2>&1; then ok=1; break; fi
  sleep 1
done

# Enable + start monitor AFTER API is up (observational only; crash must not stop API)
systemctl enable vs-server-monitor.service
systemctl restart vs-server-monitor.service || true

echo
"$PREFIX/STATUS_SERVER" || true
echo
echo "======== INSTALL SELF-TEST ========"
SELF_FAIL=0
node -v || SELF_FAIL=1
npm -v || SELF_FAIL=1
[[ -x "$API/node_modules/.bin/tsx" || -d "$API/node_modules/tsx" ]] || {
  echo "FAIL: tsx missing under $API"; SELF_FAIL=1;
}
[[ -x /usr/local/bin/vs-monitor ]] || { echo "FAIL: /usr/local/bin/vs-monitor missing"; SELF_FAIL=1; }
[[ -x "$PREFIX/MONITOR_SERVER" ]] || { echo "FAIL: MONITOR_SERVER missing"; SELF_FAIL=1; }
# server.env must exist, not world-readable, owned root + service group
if [[ ! -f "$SERVER_ENV" ]]; then
  echo "FAIL: $SERVER_ENV missing"; SELF_FAIL=1
else
  mode="$(stat -c '%a' "$SERVER_ENV" 2>/dev/null || stat -f '%OLp' "$SERVER_ENV")"
  if [[ "$mode" == *7 || "$mode" == "777" || "$mode" == "666" ]]; then
    echo "FAIL: $SERVER_ENV mode $mode is too open"; SELF_FAIL=1
  else
    echo "OK: server.env mode=$mode (secrets protected)"
  fi
fi
# Monitor console API — no token, localhost only
if ! curl -fsS "http://127.0.0.1:3000/api/v1/server/monitor/console/text" | head -5 | grep -q 'VS CORE SERVER'; then
  echo "FAIL: localhost monitor console endpoint not serving VS CORE SERVER frame" >&2
  SELF_FAIL=1
else
  echo "OK: monitor console endpoint"
fi
# Non-localhost must not get free access (best-effort; Host header alone is not enough)
# Presence of endpoint is enough; auth model tested in unit tests.
docker exec market-reader-postgres pg_isready -U "${DB_USER}" -d "${DB_NAME}" >/dev/null \
  || { echo "FAIL: Postgres"; SELF_FAIL=1; }
docker exec market-reader-redis redis-cli ping 2>/dev/null | grep -q PONG \
  || echo "WARN: Redis not ready"
systemctl is-active --quiet vs-server.service || { echo "FAIL: vs-server inactive"; SELF_FAIL=1; }
[[ "$ok" -eq 1 ]] || { echo "FAIL: /health down"; SELF_FAIL=1; }

echo "======== MSI CONTROL PANEL ========"
echo "Server LAN URL:  http://${LAN_IP:-<i3-lan-ip>}:3000"
echo "Reserve DHCP lease for this MAC/IP on your router."
echo "API_ADMIN_TOKEN is in $SERVER_ENV (not printed)."
echo
echo "======== CUSTOMER WEB PORTAL ========"
echo "URL:    http://${LAN_IP:-<i3-lan-ip>}:3000/"
echo "Create login+password in VS ADMIN → CLIENTS → CREATE WEB LOGIN"
echo "Customer needs only a browser (no installer)."
echo "WireGuard UDP:   ${VS_WG_LISTEN_PORT:-51820} (remote clients)"
echo "Local monitor:   vs-monitor"
echo "Export USB pack: sudo bash $PREFIX/2_EXPORT_USB"
echo "==================================="

if [[ "$ok" -ne 1 || "$SELF_FAIL" -ne 0 ]]; then
  echo "FAIL: INSTALL incomplete — trying FIX_CONTROL_API recovery" >&2
  journalctl -u vs-server -n 40 --no-pager >&2 || true
  if [[ -x "$HERE/FIX_CONTROL_API.sh" ]]; then
    bash "$HERE/FIX_CONTROL_API.sh" || true
  fi
  if curl -fsS "http://127.0.0.1:3000/health" >/dev/null 2>&1; then
    echo "SUCCESS: recovered via FIX_CONTROL_API"
    echo "NEXT: run  vs-monitor"
    exit 0
  fi
  echo "FAIL: still down — sudo bash SERVER/FIX_CONTROL_API.sh && journalctl -u vs-server -e" >&2
  exit 1
fi

echo "SUCCESS: VS SERVER READY (LIVE_TRADING_ENABLED=false)"
echo "NEXT: run  vs-monitor"
exit 0
