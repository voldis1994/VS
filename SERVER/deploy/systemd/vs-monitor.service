[Unit]
Description=VS CORE Monitor (alias)
Documentation=file:///opt/vs-server/MONITOR_SERVER
After=vs-server.service
Wants=vs-server.service

[Service]
Type=simple
# Root so the frame can attach to the physical console TTY when present.
User=root
Group=root
WorkingDirectory=/opt/vs-server
EnvironmentFile=-/var/lib/vs-server/server.env
Environment=VS_SERVER_ROOT=/opt/vs-server
Environment=VS_CORE_ROOT=/opt/vs-server
Environment=VS_SERVER_DATA=/var/lib/vs-server
Environment=VS_CORE_DATA=/var/lib/vs-server
Environment=LIVE_TRADING_ENABLED=false
Environment=VS_MONITOR_API_URL=http://127.0.0.1:3000
Environment=VS_MONITOR_REFRESH_MS=2000
ExecStart=/opt/vs-server/MONITOR_SERVER
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=120
StartLimitBurst=5
# Prefer physical console when available; fall back to journal if TTY missing.
TTYPath=/dev/tty1
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYReset=yes
TTYVHangup=yes
# Kill only this monitor — never PartOf=vs-server
KillMode=process

[Install]
WantedBy=multi-user.target
