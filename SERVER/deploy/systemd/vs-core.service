[Unit]
Description=VS SERVER appliance
After=network-online.target postgresql.service docker.service
Wants=network-online.target

[Service]
Type=simple
User=vs-server
Group=vs-server
WorkingDirectory=/opt/vs-server
EnvironmentFile=-/var/lib/vs-server/server.env
Environment=VS_SERVER_ROOT=/opt/vs-server
Environment=VS_CORE_ROOT=/opt/vs-server
Environment=VS_SERVER_DATA=/var/lib/vs-server
Environment=VS_CORE_DATA=/var/lib/vs-server
Environment=NODE_ENV=production
Environment=OPERATING_MODE=DEMO
Environment=LIVE_TRADING_ENABLED=false
Environment=CONTROL_API_HOST=10.77.0.1
Environment=CONTROL_API_PORT=3000
ExecStart=/opt/vs-server/deploy/boot.sh
Restart=on-failure
RestartSec=5
MemoryMax=4G
CPUQuota=200%
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/vs-server /var/log/vs-server /opt/vs-server

[Install]
WantedBy=multi-user.target
