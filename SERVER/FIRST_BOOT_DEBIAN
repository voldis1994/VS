#!/usr/bin/env bash
# FIRST_BOOT_DEBIAN — one-shot bootstrap for VS SERVER on Debian 13 (i3 appliance).
#
# What it does:
#   1) Fix WiFi / internet
#   2) Install ALL required packages (Node 20+, Docker, WireGuard, nft, …)
#   3) Start Postgres (+ Redis) via docker compose
#   4) Create secrets + server.env
#   5) INSTALL_SERVER → private network → firewall → WireGuard → START_SERVER
#   6) Enable systemd autostart with EnvironmentFile
#
# Usage (on the i3 host, as root):
#   cd /path/to/VS
#   sudo WIFI_SSID='MyNet' WIFI_PASSWORD='secret' ./SERVER/FIRST_BOOT_DEBIAN
#
# Optional env:
#   WIFI_SSID / WIFI_PASSWORD / WIFI_IFACE / WIFI_COUNTRY
#   VS_SERVER_ENDPOINT_HOSTNAME=vs-core-01.example.com
#   SKIP_WIFI=1          — skip WiFi repair
#   SKIP_DOCKER=1        — skip docker compose (external Postgres)
#   SKIP_NETWORK=1       — skip WG/firewall (local-only bind — NOT for production)
#   FORCE_SECRETS=1      — rotate MASTER_ENCRYPTION_KEY / API_ADMIN_TOKEN
#
# NEVER enables LIVE. OPERATING_MODE=DEMO, LIVE_TRADING_ENABLED=false.
set -euo pipefail

if [[ "$(id -u)" -ne 0 ]]; then
  echo "FAIL: FIRST_BOOT_DEBIAN requires root (sudo)" >&2
  exit 1
fi

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Prefer repo root when run from checkout; fall back to installed prefix parent
if [[ -f "$SCRIPT_DIR/database/docker-compose.yml" ]]; then
  REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [[ -f "$SCRIPT_DIR/../SERVER/database/docker-compose.yml" ]]; then
  REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [[ -f "$SCRIPT_DIR/../docker-compose.yml" ]]; then
  REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
elif [[ -f "$SCRIPT_DIR/docker-compose.yml" ]]; then
  REPO_ROOT="$SCRIPT_DIR"
else
  REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

PREFIX="${VS_SERVER_PREFIX:-/opt/vs-server}"
DATA="${VS_SERVER_DATA:-/var/lib/vs-server}"
LOG="${VS_SERVER_LOG:-/var/log/vs-server}"
export DEBIAN_FRONTEND=noninteractive

echo "========================================"
echo " VS SERVER — FIRST BOOT (Debian)"
echo "========================================"
echo "REPO_ROOT=$REPO_ROOT"
echo "PREFIX=$PREFIX DATA=$DATA"
echo "LIVE_TRADING_ENABLED=false (forced)"
echo

# ---------------------------------------------------------------------------
# 1) WiFi
# ---------------------------------------------------------------------------
if [[ "${SKIP_WIFI:-0}" != "1" ]]; then
  if [[ -x "$SCRIPT_DIR/FIX_WIFI" ]]; then
    "$SCRIPT_DIR/FIX_WIFI" || {
      echo "WARN: FIX_WIFI did not fully succeed — continuing if internet works"
    }
  fi
else
  echo "SKIP_WIFI=1"
fi

# Hard require some outbound path before apt of large packages
if ! ping -c1 -W3 1.1.1.1 >/dev/null 2>&1 && ! ping -c1 -W3 8.8.8.8 >/dev/null 2>&1; then
  echo "FAIL: no internet — fix WiFi first:" >&2
  echo "  sudo WIFI_SSID='…' WIFI_PASSWORD='…' $SCRIPT_DIR/FIX_WIFI" >&2
  exit 1
fi

# ---------------------------------------------------------------------------
# 2) Base OS packages
# ---------------------------------------------------------------------------
echo "==> apt packages"
apt-get update -y
apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  gnupg \
  git \
  rsync \
  jq \
  openssl \
  iproute2 \
  iptables \
  nftables \
  ufw \
  wireguard \
  wireguard-tools \
  docker.io \
  docker-compose-v2 \
  postgresql-client || apt-get install -y --no-install-recommends \
  ca-certificates curl gnupg git rsync jq openssl iproute2 iptables nftables ufw \
  wireguard wireguard-tools docker.io postgresql-client

# docker compose plugin name differs
if ! docker compose version >/dev/null 2>&1; then
  apt-get install -y docker-compose-plugin 2>/dev/null || \
    apt-get install -y docker-compose 2>/dev/null || true
fi

systemctl enable --now docker 2>/dev/null || true
systemctl enable --now systemd-timesyncd 2>/dev/null || true
timedatectl set-ntp true 2>/dev/null || true

# ---------------------------------------------------------------------------
# 3) Node.js 20+
# ---------------------------------------------------------------------------
need_node=0
if ! command -v node >/dev/null 2>&1; then
  need_node=1
else
  major="$(node -v | sed 's/^v//' | cut -d. -f1)"
  if [[ "${major:-0}" -lt 20 ]]; then
    need_node=1
  fi
fi

if [[ "$need_node" -eq 1 ]]; then
  echo "==> Node.js 20.x"
  apt-get install -y --no-install-recommends nodejs npm 2>/dev/null || true
  major="$(node -v 2>/dev/null | sed 's/^v//' | cut -d. -f1 || echo 0)"
  if [[ "${major:-0}" -lt 20 ]]; then
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    apt-get install -y nodejs
  fi
fi

echo "NODE=$(node -v) NPM=$(npm -v)"
command -v wg >/dev/null
command -v docker >/dev/null

# ---------------------------------------------------------------------------
# 4) Secrets + .env
# ---------------------------------------------------------------------------
echo "==> secrets / .env"
ENV_FILE="$REPO_ROOT/.env"
mkdir -p "$DATA" "$LOG"

gen_hex() { openssl rand -hex "$1"; }

ensure_kv() {
  # ensure_kv FILE KEY VALUE — set if missing/empty/CHANGE_ME
  local f="$1" k="$2" v="$3"
  if [[ ! -f "$f" ]]; then
    printf '%s=%s\n' "$k" "$v" >>"$f"
    return
  fi
  if grep -qE "^${k}=" "$f"; then
    local cur
    cur="$(grep -E "^${k}=" "$f" | head -1 | cut -d= -f2-)"
    if [[ -z "$cur" || "$cur" == *CHANGE_ME* || "${FORCE_SECRETS:-0}" == "1" ]]; then
      sed -i "s|^${k}=.*|${k}=${v}|" "$f"
    fi
  else
    printf '%s=%s\n' "$k" "$v" >>"$f"
  fi
}

if [[ ! -f "$ENV_FILE" && -f "$REPO_ROOT/.env.example" ]]; then
  cp "$REPO_ROOT/.env.example" "$ENV_FILE"
fi
touch "$ENV_FILE"
chmod 600 "$ENV_FILE"

DB_PASS="$(gen_hex 16)"
MASTER="$(gen_hex 32)"
ADMIN_TOK="$(gen_hex 24)"
JWT="$(gen_hex 24)"

ensure_kv "$ENV_FILE" DB_HOST 127.0.0.1
ensure_kv "$ENV_FILE" DB_PORT 5432
ensure_kv "$ENV_FILE" DB_NAME market_reader
ensure_kv "$ENV_FILE" DB_USER market_reader
ensure_kv "$ENV_FILE" DB_PASSWORD "$DB_PASS"
ensure_kv "$ENV_FILE" MASTER_ENCRYPTION_KEY "$MASTER"
ensure_kv "$ENV_FILE" API_ADMIN_TOKEN "$ADMIN_TOK"
ensure_kv "$ENV_FILE" JWT_SECRET "$JWT"
ensure_kv "$ENV_FILE" OPERATING_MODE DEMO
ensure_kv "$ENV_FILE" LIVE_TRADING_ENABLED false
ensure_kv "$ENV_FILE" CONTROL_API_PORT 3000
# Appliance binds private WG IP after network setup
ensure_kv "$ENV_FILE" CONTROL_API_HOST 10.77.0.1
ensure_kv "$ENV_FILE" VS_PRIVATE_NETWORK 1

# Mirror into durable server.env (systemd EnvironmentFile)
SERVER_ENV="$DATA/server.env"
if [[ ! -f "$SERVER_ENV" || "${FORCE_SECRETS:-0}" == "1" ]]; then
  # shellcheck disable=SC1090
  set -a
  # read current .env values
  # shellcheck disable=SC1091
  source <(grep -E '^[A-Z0-9_]+=' "$ENV_FILE" | sed 's/\r$//')
  set +a
  cat >"$SERVER_ENV" <<EOF
# VS SERVER runtime — generated by FIRST_BOOT_DEBIAN (do not commit)
OPERATING_MODE=DEMO
LIVE_TRADING_ENABLED=false
VS_PRIVATE_NETWORK=1
CONTROL_API_HOST=10.77.0.1
CONTROL_API_PORT=3000
VS_WG_INTERFACE=vs0
VS_WG_LISTEN_PORT=51820
VS_SERVER_ID=VS-CORE-01
VS_SERVER_ENDPOINT_HOSTNAME=${VS_SERVER_ENDPOINT_HOSTNAME:-VS-CORE-01}
DB_HOST=${DB_HOST:-127.0.0.1}
DB_PORT=${DB_PORT:-5432}
DB_NAME=${DB_NAME:-market_reader}
DB_USER=${DB_USER:-market_reader}
DB_PASSWORD=${DB_PASSWORD}
MASTER_ENCRYPTION_KEY=${MASTER_ENCRYPTION_KEY}
API_ADMIN_TOKEN=${API_ADMIN_TOKEN}
JWT_SECRET=${JWT_SECRET}
NODE_ENV=production
EOF
  chmod 600 "$SERVER_ENV"
else
  # Ensure critical keys present without wiping operator edits
  ensure_kv "$SERVER_ENV" OPERATING_MODE DEMO
  ensure_kv "$SERVER_ENV" LIVE_TRADING_ENABLED false
  ensure_kv "$SERVER_ENV" VS_PRIVATE_NETWORK 1
  ensure_kv "$SERVER_ENV" CONTROL_API_HOST 10.77.0.1
  ensure_kv "$SERVER_ENV" CONTROL_API_PORT 3000
  # sync secrets from .env if server.env still placeholder
  # shellcheck disable=SC1091
  set -a; source <(grep -E '^[A-Z0-9_]+=' "$ENV_FILE" | sed 's/\r$//'); set +a
  ensure_kv "$SERVER_ENV" MASTER_ENCRYPTION_KEY "${MASTER_ENCRYPTION_KEY}"
  ensure_kv "$SERVER_ENV" API_ADMIN_TOKEN "${API_ADMIN_TOKEN}"
  ensure_kv "$SERVER_ENV" DB_PASSWORD "${DB_PASSWORD}"
  ensure_kv "$SERVER_ENV" JWT_SECRET "${JWT_SECRET}"
  ensure_kv "$SERVER_ENV" DB_HOST "${DB_HOST:-127.0.0.1}"
  ensure_kv "$SERVER_ENV" DB_NAME "${DB_NAME:-market_reader}"
  ensure_kv "$SERVER_ENV" DB_USER "${DB_USER:-market_reader}"
fi

# ---------------------------------------------------------------------------
# 5) Postgres + Redis
# ---------------------------------------------------------------------------
if [[ "${SKIP_DOCKER:-0}" != "1" ]]; then
  echo "==> docker compose (postgres + redis)"
  cd "$REPO_ROOT"
  # Export DB_* for compose variable substitution
  set -a
  # shellcheck disable=SC1091
  source <(grep -E '^[A-Z0-9_]+=' "$ENV_FILE" | sed 's/\r$//')
  set +a
  if docker compose version >/dev/null 2>&1; then
    docker compose up -d
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose up -d
  else
    echo "FAIL: docker compose not available" >&2
    exit 1
  fi
  echo "Waiting for Postgres…"
  for i in $(seq 1 60); do
    if docker exec market-reader-postgres pg_isready -U "${DB_USER:-market_reader}" -d "${DB_NAME:-market_reader}" >/dev/null 2>&1; then
      break
    fi
    sleep 1
  done
  docker exec market-reader-postgres pg_isready -U "${DB_USER:-market_reader}" -d "${DB_NAME:-market_reader}"
else
  echo "SKIP_DOCKER=1 — ensure Postgres reachable per .env"
fi

# ---------------------------------------------------------------------------
# 6) INSTALL_SERVER
# ---------------------------------------------------------------------------
echo "==> INSTALL_SERVER"
cd "$REPO_ROOT/SERVER"
chmod +x INSTALL_SERVER START_SERVER STOP_SERVER STATUS_SERVER FIX_WIFI FIRST_BOOT_DEBIAN \
  network/* deploy/*.sh 2>/dev/null || true
./INSTALL_SERVER

# Copy .env next to installed control-api (dotenv load path)
mkdir -p "$PREFIX/control-api"
cp -a "$ENV_FILE" "$PREFIX/control-api/.env"
cp -a "$ENV_FILE" "$PREFIX/.env" 2>/dev/null || true
# Also keep repo-relative ../../../../.env resolution from installed tree:
# control-api/src/db → four levels up = /opt — place symlink helper
if [[ ! -f /opt/.env ]]; then
  cp -a "$ENV_FILE" /opt/.env
  chmod 600 /opt/.env
fi
chown -R vs-server:vs-server "$DATA" "$LOG" 2>/dev/null || true
chown vs-server:vs-server "$PREFIX/control-api/.env" "$SERVER_ENV" 2>/dev/null || true

# Patch systemd unit to load EnvironmentFile
UNIT=/etc/systemd/system/vs-server.service
if [[ -f "$UNIT" ]]; then
  if ! grep -q 'EnvironmentFile=/var/lib/vs-server/server.env' "$UNIT"; then
    sed -i '/\[Service\]/a EnvironmentFile=-/var/lib/vs-server/server.env' "$UNIT"
  fi
  # Private network bind (not localhost-only) when WG is used
  sed -i 's|Environment=CONTROL_API_HOST=127.0.0.1|Environment=CONTROL_API_HOST=10.77.0.1|' "$UNIT" || true
  systemctl daemon-reload
fi

# ---------------------------------------------------------------------------
# 7) Private network + firewall + WireGuard
# ---------------------------------------------------------------------------
load_runtime_env() {
  set -a
  # shellcheck disable=SC1090
  source "$SERVER_ENV"
  # shellcheck disable=SC1090
  source <(grep -E '^[A-Z0-9_]+=' "$PREFIX/control-api/.env" | sed 's/\r$//')
  set +a
  export LIVE_TRADING_ENABLED=false
  export OPERATING_MODE=DEMO
}

if [[ "${SKIP_NETWORK:-0}" != "1" ]]; then
  echo "==> SETUP_PRIVATE_NETWORK"
  load_runtime_env
  export VS_SETUP_NONINTERACTIVE=1
  export VS_SETUP_CREATE_ADMIN=Y
  export VS_SERVER_ENDPOINT_HOSTNAME="${VS_SERVER_ENDPOINT_HOSTNAME:-VS-CORE-01}"
  VS_SERVER_DATA="$DATA" VS_CORE_DATA="$DATA" "$PREFIX/network/SETUP_PRIVATE_NETWORK"

  echo "==> APPLY_FIREWALL"
  "$PREFIX/network/APPLY_FIREWALL"

  echo "==> UP_WIREGUARD"
  VS_SERVER_DATA="$DATA" "$PREFIX/network/UP_WIREGUARD"
else
  echo "SKIP_NETWORK=1 — binding will follow CONTROL_API_HOST in server.env"
  # Dev/local only: allow unbound private net
  ensure_kv "$SERVER_ENV" VS_PRIVATE_NETWORK 0
  ensure_kv "$SERVER_ENV" CONTROL_API_HOST 127.0.0.1
fi

# ---------------------------------------------------------------------------
# 8) START_SERVER (systemd preferred — avoid double-bind with nohup)
# ---------------------------------------------------------------------------
echo "==> START_SERVER"
load_runtime_env

# Ensure WireGuard identity keys exist (START_SERVER does this; dry-run identity only)
if [[ -x "$PREFIX/control-api/node_modules/.bin/tsx" ]]; then
  (
    cd "$PREFIX/control-api"
    VS_SERVER_DATA="$DATA" VS_CORE_DATA="$DATA" ./node_modules/.bin/tsx -e "
import { getDeviceRegistry } from './src/vs-core/network/deviceRegistry.ts';
import { ensureServerIdentity } from './src/vs-core/network/deviceLifecycle.ts';
const root = process.env.VS_SERVER_DATA || '';
if (!root) throw new Error('VS_SERVER_DATA required');
const id = ensureServerIdentity(getDeviceRegistry(root), root);
console.log('SERVER_IDENTITY', id.server_id);
" || true
  )
fi

# Stop any leftover nohup instance before systemd takes over
if [[ -f "$DATA/vs-server.pid" ]]; then
  old="$(cat "$DATA/vs-server.pid" 2>/dev/null || true)"
  if [[ -n "$old" ]] && kill -0 "$old" 2>/dev/null; then
    kill "$old" 2>/dev/null || true
    sleep 1
    kill -9 "$old" 2>/dev/null || true
  fi
  rm -f "$DATA/vs-server.pid"
fi

systemctl enable vs-server.service vs-server-watchdog.timer 2>/dev/null || true
if systemctl restart vs-server.service 2>/dev/null || systemctl start vs-server.service 2>/dev/null; then
  echo "INFO: started via systemd vs-server.service"
else
  echo "WARN: systemd start failed — falling back to START_SERVER nohup"
  VS_SERVER_DATA="$DATA" VS_CORE_DATA="$DATA" \
    CONTROL_API_HOST="${CONTROL_API_HOST}" \
    "$PREFIX/START_SERVER"
fi

# Health wait
ok=0
for i in $(seq 1 60); do
  if curl -fsS "http://127.0.0.1:3000/health" >/dev/null 2>&1 \
    || curl -fsS "http://10.77.0.1:3000/health" >/dev/null 2>&1; then
    ok=1
    break
  fi
  sleep 1
done

echo
"$PREFIX/STATUS_SERVER" || true
echo

if [[ -f "$DATA/network/issued/ADMIN_ENROLLMENT.json" ]]; then
  echo "ADMIN_ENROLLMENT (save this code for ADMIN PC):"
  jq -r '"  enrollment_code=" + .enrollment_code + "\n  device_id=" + .device_id + "\n  expires_at=" + .expires_at' \
    "$DATA/network/issued/ADMIN_ENROLLMENT.json" 2>/dev/null \
    || cat "$DATA/network/issued/ADMIN_ENROLLMENT.json"
  echo
fi

echo "API_ADMIN_TOKEN is in $SERVER_ENV (chmod 600)"
echo "MASTER_ENCRYPTION_KEY is in $SERVER_ENV — do not lose it"
echo

if [[ "$ok" -ne 1 ]]; then
  echo "FAIL: health endpoint not up — see $LOG/server.out and: journalctl -u vs-server -e" >&2
  exit 1
fi

echo "SUCCESS: VS SERVER is running (DEMO, LIVE=false)"
echo "NOTE: LIVE_READY is NOT claimed — Capital DEMO still EXTERNAL_BLOCKER until configured"
echo "Next on ADMIN PC: INSTALL_ADMIN → put enrollment_code → START_ADMIN"
exit 0
