# Native 10s OHLC + EARLY micro path. Default OFF.
# Set to 1 to re-enable mid→10s buckets + SECOND aggregate + EARLY TRIGGERED.
# TEN_SEC_OHLC_ENABLED=1

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=market_reader
DB_USER=market_reader
DB_PASSWORD=CHANGE_ME

# Redis (optional cache/pub-sub)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security
MASTER_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_OR_BASE64_KEY_HERE
JWT_SECRET=CHANGE_ME_JWT_SECRET
API_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# Operating mode: REPLAY | PAPER | DEMO | LIVE
OPERATING_MODE=LIVE
LIVE_TRADING_ENABLED=true

# Market Core
MARKET_CORE_HOST=localhost
MARKET_CORE_PORT=9100
MARKET_CORE_CONFIG_DIR=./config

# Execution Service
EXECUTION_SERVICE_HOST=localhost
EXECUTION_SERVICE_PORT=9101

# Control API
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3000
CONTROL_API_WS_PORT=3001
# URL market-core LIVE bridge uses to publish EntryReady intents
CONTROL_API_URL=http://127.0.0.1:3000
# Comma-separated admin + client web origins (credentials/cookies)
CORS_ORIGIN=http://localhost:5173
CLIENT_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CLIENT_COOKIE_SECURE=false
# Set true / hop count / CIDR list behind reverse proxy so request.ip is trusted
TRUST_PROXY=false

# Pipeline service auth (market-core → POST /api/pipeline/*)
# Required in production (fail-closed). Same value on market-core + control-api.
# Prefer PIPELINE_TOKEN; PIPELINE_SERVICE_TOKEN also accepted.
PIPELINE_TOKEN=CHANGE_ME_PIPELINE_TOKEN
PIPELINE_SERVICE_TOKEN=

# Capital.com (optional - for live/demo)
CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=
CAPITAL_IDENTIFIER=
CAPITAL_ENVIRONMENT=demo

# Market Core LIVE bridge (Client Panel production path)
# Run: market-core --mode LIVE --bridge
# Or: MARKET_CORE_BRIDGE=1 market-core --mode LIVE
MARKET_CORE_BRIDGE=0

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Dashboard (admin desk) — port 5173
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_CLIENT_WS_URL=ws://localhost:3000/ws/client

# Client-only panel — for REMOTE clients use Cloudflare tunnel (not LAN IP)
# Double-click VS.bat → https://….trycloudflare.com  ← send THAT + access code
# Stable production host example:
VITE_CLIENT_PANEL_URL=

# Trade journal (Excel CSV on your PC — why opened / why closed)
# Default: <repo>/data/exports/VS-trade-journal.csv
# TRADE_JOURNAL_DIR=C:\Users\You\Documents\VS-trades
# TRADE_JOURNAL_PATH=C:\Users\You\Documents\VS-trades\my-journal.csv
# TRADE_JOURNAL_SEP=;
