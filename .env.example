# Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=market_reader
DB_USER=market_reader
DB_PASSWORD=CHANGE_ME

# Redis (optional cache/pub-sub)
REDIS_HOST=localhost
REDIS_PORT=6379

# Security — REQUIRED. Never use CHANGE_ME in running systems.
# Generate e.g.: openssl rand -hex 32
MASTER_ENCRYPTION_KEY=
JWT_SECRET=CHANGE_ME_JWT_SECRET
API_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

# Operating mode: REPLAY | PAPER | DEMO | LIVE
# LIVE cannot be enabled via ADMIN settings API — process env + restart only.
# Default PAPER for infrastructure; LIVE_TRADING_ENABLED stays false (fail-closed).
OPERATING_MODE=PAPER
LIVE_TRADING_ENABLED=false

# Market Core
MARKET_CORE_HOST=localhost
MARKET_CORE_PORT=9100
MARKET_CORE_CONFIG_DIR=./config

# Execution Service
EXECUTION_SERVICE_HOST=localhost
EXECUTION_SERVICE_PORT=9101

# Control API — appliance binds 0.0.0.0 with VS_LAN_MANAGEMENT=1 (firewall: LAN+WG only)
CONTROL_API_HOST=0.0.0.0
CONTROL_API_PORT=3000
CONTROL_API_WS_PORT=3001
# Local loopback URL for co-located services on i3
CONTROL_API_URL=http://127.0.0.1:3000
# MSI Control Panel origin(s); * allowed for LAN setup
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,*
CLIENT_CORS_ORIGIN=http://localhost:5173,http://localhost:5174
CLIENT_COOKIE_SECURE=false
TRUST_PROXY=false

# Private network + LAN admin (MSI on same Wi-Fi)
VS_PRIVATE_NETWORK=1
VS_LAN_MANAGEMENT=1
VS_WG_LISTEN_PORT=51820
# Set to i3 LAN IP for WireGuard peer Endpoint (remote clients / USB pack)
# VS_SERVER_ENDPOINT_IP=192.168.0.53

# Pipeline service auth (ONLY for optional C++ market-core --bridge → POST /api/pipeline/*)
# Node robotDesk LIVE trading does NOT need this — Capital keys live in Brokers/DB.
# Prefer PIPELINE_TOKEN; PIPELINE_SERVICE_TOKEN is an alias (same value).
# Leave as CHANGE_ME unless you intentionally run the C++ LIVE bridge.
PIPELINE_TOKEN=CHANGE_ME_PIPELINE_TOKEN
PIPELINE_SERVICE_TOKEN=

# Capital.com (optional .env fallback for C++ bridge only — Node uses encrypted DB credentials)
CAPITAL_API_KEY=
CAPITAL_API_PASSWORD=
CAPITAL_IDENTIFIER=
CAPITAL_ENVIRONMENT=demo

# Market Core LIVE bridge (optional; default OFF — Node robotDesk is the entry brain)
# Requires real PIPELINE_TOKEN + CAPITAL_* above. Run: market-core --mode LIVE --bridge
MARKET_CORE_BRIDGE=0

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Dashboard (admin desk) — port 5173
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000/ws
VITE_CLIENT_WS_URL=ws://localhost:3000/ws/client

# Client-only panel — for REMOTE clients use Cloudflare tunnel (not LAN IP)
# Double-click VS.bat → https://….trycloudflare.com  ← send THAT + access code
# Stable production host example:
VITE_CLIENT_PANEL_URL=
